[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm64/
*.nupkg
packages/
TestResults/
*.log

# JetBrains / VS Code
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Node (if a web-based UI layer is chosen)
node_modules/

