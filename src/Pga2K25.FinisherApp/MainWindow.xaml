<Window x:Class="Pga2K25.FinisherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fin="clr-namespace:Pga2K25.Finisher.Desktop;assembly=Pga2K25.Finisher.Desktop"
        Title="TGC 2K25 Course Finisher (C# port of v0.10 REV10E)" Height="900" Width="1000" MinHeight="600" MinWidth="800"
        Background="White" FontFamily="Georgia" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Course Finisher" FontSize="26" FontWeight="Bold" Foreground="#1f1d1a"/>
            <TextBlock Foreground="#6b665e" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Finishing passes for PGA TOUR 2K25 courses imported with the TGC Tool (LiDAR / heightmap)."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Input .course" VerticalAlignment="Center"/>
            <TextBox x:Name="CourseBox" Grid.Column="1" Padding="4"/>
            <Button Grid.Column="2" Content="Browse…" Click="BrowseCourse_Click"/>
        </Grid>
        <fin:FinisherPanel x:Name="Finisher" Grid.Row="2"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="OpenButton" Content="Open Greens Book" Margin="0" IsEnabled="False" Click="Open_Click"/>
            <Button Content="Clear Output" Click="Clear_Click"/>
        </StackPanel>
        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="#d8d4cc"/>
    </Grid>
</Window>
