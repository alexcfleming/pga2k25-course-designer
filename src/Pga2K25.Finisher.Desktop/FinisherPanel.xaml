<UserControl x:Class="Pga2K25.Finisher.Desktop.FinisherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Grey" Color="#6b665e"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Port of Mal's TGC 2K25 Course Finisher (v0.10 REV10E) for imported TGC Tool / LiDAR courses: spline smoothing, tee sets and levelling, fast-green-safe pins, cart-path levelling, heavy rough, weathering and native water. Always writes a new course file."/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Finished course" VerticalAlignment="Center"/>
                <TextBox x:Name="FinishedBox" Grid.Column="1" Padding="4"
                         ToolTip="Defaults to '&lt;course&gt; - Finished.course' in the output folder. Never the input file."/>
                <Button Grid.Column="2" Content="Browse…" Click="BrowseFinished_Click"/>
                <Button x:Name="AnalyzeButton" Grid.Column="3" Content="Analyze Course" Click="Analyze_Click"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <GroupBox Header="1. Designer Smooth Splines" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" Text="Native 2K25 spline smoothing." Margin="0,0,0,4"/>
                            <WrapPanel x:Name="SmoothPanel">
                                <CheckBox Content="Tee Boxes" Tag="teebox"/>
                                <CheckBox Content="Greens" Tag="green"/>
                                <CheckBox Content="Fairways" Tag="fairway"/>
                                <CheckBox Content="Rough" Tag="rough"/>
                                <CheckBox Content="Bunkers" Tag="bunker"/>
                                <CheckBox Content="Cart Paths" Tag="cartpath"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="2. Optimize Splines" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" Text="Optional waypoint reduction." Margin="0,0,0,4"/>
                            <WrapPanel x:Name="OptimizePanel">
                                <CheckBox Content="Tee Boxes" Tag="teebox"/>
                                <CheckBox Content="Greens" Tag="green"/>
                                <CheckBox Content="Fairways" Tag="fairway"/>
                                <CheckBox Content="Rough" Tag="rough"/>
                                <CheckBox Content="Bunkers" Tag="bunker"/>
                                <CheckBox Content="Cart Paths" Tag="cartpath"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="4. Native Water Finishing" Padding="6">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Streams ignored. 4-point body first; adds edges only to avoid low-land exposure."/>
                            <CheckBox x:Name="WaterBox" Content="Create native water: closed lakes / ponds only" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ReplaceWaterBox" Content="Replace generated water" IsChecked="True" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBlock Text="Shoreline clearance (m)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ClearanceBox" Text="0.15" Width="44" Padding="2" Margin="0,0,14,0"/>
                                <TextBlock Text="Merge level spread max (m)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="MergeSpreadBox" Text="0.50" Width="44" Padding="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <GroupBox Grid.Column="2" Header="3. Terrain Finishing" Padding="6">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="CompleteTeesBox" Content="Create / complete tee sets" IsChecked="True"/>
                            <TextBlock Text="Target total tees per hole" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="TargetTeesBox" Width="44" SelectedIndex="3">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" Margin="0,0,0,4" Text="Back tee centered left-right; unresolved tees park 1 m forward."/>
                        <CheckBox x:Name="LevelTeesBox" Content="Level tee boxes (Brush 9)" IsChecked="True" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" Margin="0,0,0,4" Text="0.0 ft: whole pad if single; local if shared."/>
                        <CheckBox x:Name="HeavyRoughBox" Content="Heavy Rough: outside feature edges" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4" Text="Closed surfaces: scale 10, centers 2 m outside edge. Cart paths: scale 13 on centerline."/>
                        <WrapPanel Margin="0,0,0,2">
                            <CheckBox x:Name="PinsBox" Content="Smart pin placement (4 per green)"/>
                            <ComboBox x:Name="PinModeBox" Width="215" SelectedIndex="0">
                                <ComboBoxItem Content="Preserve good / repair unsafe"/>
                                <ComboBoxItem Content="Rebuild all 4"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4" Text="Repair keeps safe manual pins; fast-green target &lt;=2.0%, ceiling 2.4%."/>
                        <WrapPanel Margin="0,0,0,2">
                            <CheckBox x:Name="UltraSafeBox" Content="Ultra Speed-Safe Greens"/>
                            <ComboBox x:Name="SeverityBox" Width="110" SelectedIndex="1">
                                <ComboBoxItem Content="Safe"/>
                                <ComboBoxItem Content="More Safe"/>
                                <ComboBoxItem Content="Most Safe"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4" Text="Compresses vertical relief only; preserves ridge/bowl locations and break direction."/>
                        <CheckBox x:Name="WeatheringBox" Content="Organic topographic weathering (greens + fairways/rough)" Margin="0,0,0,4"/>
                        <CheckBox x:Name="FinisherBookBox" Content="Export greens book (PNG per hole + PDF)" IsChecked="True" Margin="0,0,0,4"/>
                        <CheckBox x:Name="CartPathsBox" Content="Level cart paths" IsChecked="True" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ReplaceLegacyBox" Content="Replace prior cart-path leveling" IsChecked="True" Margin="0,0,0,4"/>
                        <CheckBox x:Name="PreserveManualBox" Content="Preserve manual cart-path edits" IsChecked="True" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" Text="Cart-path leveling runs after spline edits."/>
                    </StackPanel>
                </GroupBox>
            </Grid>
            <Button x:Name="FinishButton" Content="Create Finished Course" HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Bold" Click="Finish_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
