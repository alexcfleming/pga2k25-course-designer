<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pga2K25.Studio.ViewModels"
             x:Class="Pga2K25.Studio.Views.HoleSimView"
             x:DataType="vm:HoleSimViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="PillTemplate" x:DataType="vm:TabViewModel">
      <Button Classes="pill" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding SelectCommand}" MinHeight="32"/>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="1500" HorizontalAlignment="Left" Margin="0,0,12,24">

      <!-- Header -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <ProgressBar IsIndeterminate="True" Width="110" IsVisible="{Binding Busy}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="Hole design simulator" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ContextText}" Classes="mono small"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{Binding FileText}" Classes="muted small" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding WatchText}" Classes="muted small" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding TerrainStatus}"
                     Classes="muted small" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- New save -->
      <Border Classes="card" Padding="16" Background="#FDF1EA" BorderBrush="#E8B79E" IsVisible="{Binding HasNewSave}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding NewSaveTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding NewSaveLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding StringFormat='•  {0}'}" TextWrapping="Wrap"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding NewSaveNote}" Classes="muted small" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Reload this hole" Command="{Binding ReloadSaveCommand}"/>
            <Button Content="Not now" Command="{Binding NotNowCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="12" Background="#EEF5EF" IsVisible="{Binding ReloadedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ReloadedText}" TextWrapping="Wrap" Classes="small"/>
      </Border>

      <!-- Steps -->
      <ItemsControl ItemsSource="{Binding StepButtons}" ItemTemplate="{StaticResource PillTemplate}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- 1 Pick -->
      <Border Classes="card" Padding="16" IsVisible="{Binding IsPick}">
        <StackPanel Spacing="12">
          <TextBlock Text="Pick the hole" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="HOLE" Classes="muted small" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding HoleButtons}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <Button Classes="hole" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding SelectCommand}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="TEE" Classes="muted small" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding TeeButtons}" ItemTemplate="{StaticResource PillTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="PIN" Classes="muted small" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding PinButtons}" ItemTemplate="{StaticResource PillTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="{Binding PickSummary}" Classes="muted small"/>
          <TextBlock Text="Changing the hole, tee or pin clears results that depend on it. A new hole or tee needs the read-back confirming again."
                     Classes="muted small" TextWrapping="Wrap"/>
          <Button Classes="primary" Content="Read back this hole" Command="{Binding GoReadBackCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 2 Read back -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding IsReadBack}">
        <Border Classes="card" Padding="8" VerticalAlignment="Top">
          <Image Source="{Binding HoleMap}" Stretch="Uniform" MaxHeight="760" MaxWidth="420" AutomationProperties.Name="Hole map from the course file"/>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Text="Does this match what's open in the game?" FontSize="16" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding ReadBackRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourcedRowViewModel">
                  <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,7">
                    <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Item}" Classes="muted" TextWrapping="Wrap"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueInk}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>
                      </StackPanel>
                      <Border Grid.Column="2" Classes="chip" Background="{Binding TagFill}" Padding="8,1" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TagInk}"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card" Padding="12" Background="#FDF1EA" BorderBrush="#E8B79E" IsVisible="{Binding HasUnknown}">
              <StackPanel Spacing="8">
                <TextBlock Text="Surfaces the model has no rule for, within 60 yds of the line. How should they play?" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding UnknownRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnknownSurfaceViewModel">
                      <Grid ColumnDefinitions="*,200" ColumnSpacing="12" Margin="0,2">
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:UnknownSurfaceViewModel.Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ReadBackStatus}" Classes="muted small" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Yes, it all matches" Command="{Binding AcceptReadBackCommand}"/>
              <Button Content="Something differs" Command="{Binding MarkDiffersCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 3 Assumptions -->
      <Border Classes="card" Padding="16" IsVisible="{Binding IsAssumptions}">
        <StackPanel Spacing="10">
          <TextBlock Text="Confirm the assumptions" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Every row needs a confirm or an edit. Values you confirmed before fill in here, but still need confirming. PLACEHOLDER values are unvalidated defaults, shown in orange wherever they're used."
                     Classes="muted small" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding GroupButtons}" ItemTemplate="{StaticResource PillTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding AssumptionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AssumptionRowViewModel">
                <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,8">
                  <Grid ColumnDefinitions="260,*,Auto,190" ColumnSpacing="12">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Value}" Foreground="{Binding ValueInk}" TextWrapping="Wrap" IsVisible="{Binding !Editing}"/>
                      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" IsVisible="{Binding IsChoice}" MinWidth="200"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Editing}">
                        <TextBox Text="{Binding EditText}" MinWidth="160"/>
                        <Button Classes="primary" Content="Save" Command="{Binding ApplyEditCommand}" MinHeight="30" Padding="10,0"/>
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" MinHeight="30" Padding="10,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Error}" Foreground="#B4471F" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <TextBlock Text="{Binding Note}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip" Background="{Binding TagFill}" Padding="8,1" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TagInk}"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                      <TextBlock Text="Confirmed" Foreground="#1F4D30" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding Confirmed}"/>
                      <Button Classes="primary" Content="Confirm" Command="{Binding ConfirmCommand}" IsVisible="{Binding NotConfirmed}" MinHeight="30" Padding="10,0"/>
                      <Button Content="Edit" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" MinHeight="30" Padding="10,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Content="Confirm this group" Command="{Binding ConfirmGroupCommand}"/>
              <Button Classes="primary" Content="Next: run" Command="{Binding GoRunCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding AssumptionProgress}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- 4 Live checks -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding IsLiveChecks}">
        <Border Classes="card" Padding="8" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <Image Source="{Binding SpotMap}" Stretch="Uniform" MaxHeight="720" MaxWidth="360" AutomationProperties.Name="Where to take MEASURE readings"/>
            <TextBlock Text="Gold: still to measure. Green: read." Classes="muted small"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="14">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="A. Height readings with MEASURE" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Move the MEASURE cursor until the game's TO TEE and TO GREEN match the spot's yards, then type the height against the zero as the game shows it: ▲ or + for above, ▼ or − for below. +1'4&quot; is 16 in and +1' is 12 in. For G, copy GREEN HEIGHT from the tee table. Skip any spot you can't reach; five or more are needed."
                         Classes="muted small" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="ZERO IS AT" Classes="muted small" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding ZeroButtons}" ItemTemplate="{StaticResource PillTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SpotRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpotRowViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="44,190,130,*,120" ColumnSpacing="10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="e.g. ▲0'7&quot;" MinHeight="30"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Parsed}" Foreground="{Binding ParsedInk}" Classes="small" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Model}" Classes="muted small"/>
                        </StackPanel>
                        <CheckBox Grid.Column="4" Content="Hold back" IsChecked="{Binding HeldOut}" ToolTip.Tip="Held-back readings aren't used to fit the correction; they test it."/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding LiveSummary}" Classes="small" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding LiveFileText}" Classes="muted small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="B. Readings round the pins" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Two or three per pin, against the same zero as above: a few yards above the pin and below it on its fall line, and one across the slope (held back to test the fit). They check the green's contours, which decide how putts break and whether shots hold."
                         Classes="muted small" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding GreenSpotRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpotRowViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="44,190,130,*,120" ColumnSpacing="10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="e.g. ▲0'7&quot;" MinHeight="30"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Parsed}" Foreground="{Binding ParsedInk}" Classes="small" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Model}" Classes="muted small"/>
                        </StackPanel>
                        <CheckBox Grid.Column="4" Content="Hold back" IsChecked="{Binding HeldOut}" ToolTip.Tip="Held-back readings aren't used to fit the correction; they test it."/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding GreenSpotSummary}" Classes="small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SightlineQuestion, StringFormat='C. {0}'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding SightlineButtons}" ItemTemplate="{StaticResource PillTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Kept for the sightline check when the terrain is trusted (a later stage)." Classes="muted small"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Text="D. Drives from this tee (optional)" FontSize="16" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding DriveRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DriveRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Number}" Width="20" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding CarryText}" PlaceholderText="carry" Width="90" MinHeight="30"/>
                      <TextBox Text="{Binding TotalText}" PlaceholderText="total" Width="90" MinHeight="30"/>
                      <ComboBox ItemsSource="{x:Static vm:DriveRowViewModel.Sides}" SelectedItem="{Binding Side}" Width="70"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DriveSummary}" Classes="small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="Check the terrain" Command="{Binding GoGateCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>

      <!-- 5 Terrain gate -->
      <Border Classes="card" Padding="16" IsVisible="{Binding IsGate}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="12" Height="12" Fill="{Binding GateBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding GateTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Text="{Binding GateDetail}" TextWrapping="Wrap"/>
          <TextBlock Text="Bands: under 10% of the readings' range is Trustworthy, 10–18% Indicative (results carry a warning), over 18% or fewer than five readings is Check. A corrected model is judged only on the readings held back from its fit."
                     Classes="muted small" TextWrapping="Wrap"/>
          <TextBlock Text="CANDIDATES" Classes="muted small" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding GateCandidates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GateCandidateViewModel">
                <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,6">
                  <Grid ColumnDefinitions="90,*,110,200" ColumnSpacing="10">
                    <Button Classes="pill" Classes.selected="{Binding IsChosen}" Content="Use" Command="{Binding ChooseCommand}" MinHeight="28"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Band}" Foreground="{Binding BandInk}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Error}" Classes="mono small" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="READINGS AGAINST THE CHOSEN MODEL" Classes="muted small" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="60,90,90,90,90">
            <TextBlock Text="Spot" Classes="muted small"/>
            <TextBlock Grid.Column="1" Text="Model" Classes="muted small" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="Reading" Classes="muted small" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="Error" Classes="muted small" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="Use" Classes="muted small" HorizontalAlignment="Right"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding GateChecks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GateCheckRowViewModel">
                <Grid ColumnDefinitions="60,90,90,90,90">
                  <TextBlock Text="{Binding Spot}" Classes="mono"/>
                  <TextBlock Grid.Column="1" Text="{Binding Model}" Classes="mono" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="{Binding Reading}" Classes="mono" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="{Binding ErrorInk}" Classes="mono" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="{Binding Use}" Classes="muted small" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="RUNS USE" Classes="muted small" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding ModeButtons}" ItemTemplate="{StaticResource PillTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="{Binding ModeNote}" Classes="muted small" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Take more readings" Command="{Binding GoLiveChecksCommand}"/>
            <Button Classes="primary" Content="Next: run" Command="{Binding GoRunCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 5b Green contours -->
      <Border Classes="card" Padding="16" IsVisible="{Binding IsGate}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="12" Height="12" Fill="{Binding GreenGateBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding GreenGateTitle, StringFormat='Green contours · {0}'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Text="{Binding GreenGateDetail}" TextWrapping="Wrap"/>
          <TextBlock Text="The readings round the pins, against G, compared with the replay's contours, the contours scaled to fit the readings (the game may smooth drawn greens), and a flat green. Same bands, judged on a green's few feet of relief; four readings are enough."
                     Classes="muted small" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding GreenCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GateCandidateViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="90,*,110,200" ColumnSpacing="10">
                        <Button Classes="pill" Classes.selected="{Binding IsChosen}" Content="Use" Command="{Binding ChooseCommand}" MinHeight="28"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Band}" Foreground="{Binding BandInk}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Error}" Classes="mono small" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding GreenChecks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GateCheckRowViewModel">
                    <Grid ColumnDefinitions="60,90,90,90,90">
                      <TextBlock Text="{Binding Spot}" Classes="mono"/>
                      <TextBlock Grid.Column="1" Text="{Binding Model}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding Reading}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="{Binding ErrorInk}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding Use}" Classes="muted small" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primary" Content="Next: green read" Command="{Binding GoGreenCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 6 Run -->
      <StackPanel Spacing="14" IsVisible="{Binding IsRun}">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Run: tee shots" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding TerrainStatus}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding PlayerButtons}" ItemTemplate="{StaticResource PillTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Aims from 60 left to 60 right of the game's aim marker, every 5 yds, 2,000 drives each with the same random draws. Each finish is valued in strokes gained against the baseline."
                       Classes="muted small" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding RunBlockers}" Foreground="#B4471F" TextWrapping="Wrap" IsVisible="{Binding RunBlockers, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Button Classes="primary" Content="Run" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" HorizontalAlignment="Left" MinWidth="120"/>
            <TextBlock Text="{Binding PreviousResultText}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding PreviousResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasResults}">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Image Source="{Binding PatternMap}" Stretch="Uniform" MaxHeight="620" MaxWidth="460" AutomationProperties.Name="Where drives finish"/>
              <ItemsControl ItemsSource="{Binding PatternLegend}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LegendItemViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="10" Height="10" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" Classes="small"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ResultTitle}" Classes="mono small" TextWrapping="Wrap"/>
              <Border Classes="chip" Background="#FBE6DC" HorizontalAlignment="Left" Padding="10,2">
                <TextBlock Text="{Binding ResultBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="#B4471F"/>
              </Border>
              <TextBlock Text="{Binding BestText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="56,64,58,58,58,52,66,150,60,58" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="Aim" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Fairway" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Rough" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Native" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Bunker" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Scrub" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="Yds left" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="7" Text="SG off the tee" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="8" Text="Exp." Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="9" Text="Off table" Classes="muted small" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding AimRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AimRowViewModel">
                    <Border Background="{Binding Fill}" CornerRadius="4" Padding="0,2">
                      <Grid ColumnDefinitions="56,64,58,58,58,52,66,150,60,58">
                        <TextBlock Grid.Column="0" Text="{Binding Aim}" FontWeight="{Binding Weight}" Classes="mono"/>
                        <TextBlock Grid.Column="1" Text="{Binding Fairway}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="2" Text="{Binding Rough}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="3" Text="{Binding Native}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="4" Text="{Binding Bunker}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="5" Text="{Binding Scrub}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="6" Text="{Binding YardsLeft}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="7" Text="{Binding Sg}" HorizontalAlignment="Right" FontWeight="{Binding Weight}" Classes="mono"/>
                        <TextBlock Grid.Column="8" Text="{Binding Expected}" HorizontalAlignment="Right" Classes="mono"/>
                        <TextBlock Grid.Column="9" Text="{Binding Outside}" HorizontalAlignment="Right" Classes="mono"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding RunNotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DependsText}" Foreground="#B4471F" Classes="small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- 7 Green read -->
      <StackPanel Spacing="14" IsVisible="{Binding IsGreen}">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding GreenTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding GreenSummary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding GreenStatus}" Classes="muted small" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding GreenPinButtons}" ItemTemplate="{StaticResource PillTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <ProgressBar Value="{Binding GreenProgress}" Maximum="100" Width="320" IsVisible="{Binding GreenBusy}"/>
              <Image Source="{Binding GreenMap}" Stretch="Uniform" MaxHeight="640" MaxWidth="520" AutomationProperties.Name="Expected putts on the green"/>
              <TextBlock Text="Green 1 putt · gold 2 · red 3 or more. Arrows point downhill; hatched cells are too steep for a ball to stop." Classes="muted small" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding GreenPinText}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="40,*,80,90,120,80" Margin="0,6,0,0">
                <TextBlock Text="Pin" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Where" Classes="muted small"/>
                <TextBlock Grid.Column="2" Text="Avg putts" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Needs 2.3+" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Above / below" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Cup slope" Classes="muted small" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding GreenPinRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GreenPinRowViewModel">
                    <Grid ColumnDefinitions="40,*,80,90,120,80">
                      <TextBlock Text="{Binding Pin}" Classes="mono"/>
                      <TextBlock Grid.Column="1" Text="{Binding Where}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="2" Text="{Binding Average}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Hard}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding AboveBelow}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="5" Text="{Binding CupSlope}" Foreground="{Binding CupInk}" Classes="mono" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Build every pin" Command="{Binding BuildAllPinsCommand}" HorizontalAlignment="Left"/>
              <TextBlock Text="Above / below: average putts from 15–30 ft, from the half of the green above the hole and the half below it. Cup slope in red is steeper than a ball can stop on." Classes="muted small" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding PutterText}" Classes="muted small" TextWrapping="Wrap"/>
              <Border Classes="chip" Background="#FBE6DC" HorizontalAlignment="Left" Padding="10,2">
                <TextBlock Text="Putting physics and green roll are placeholders; the putter is fitted to the secondary anchors" FontSize="11.5" FontWeight="SemiBold" Foreground="#B4471F" TextWrapping="Wrap"/>
              </Border>
              <Button Classes="primary" Content="Next: approach" Command="{Binding GoApproachCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- 8 Approach -->
      <StackPanel Spacing="14" IsVisible="{Binding IsApproach}">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Approach: shots at the green" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="The golfer is fitted to the baseline's anchors, then plays 600 shots at your aim. Each shot carries short of the aim by its planned release, spreads by distance and lie, then bounces and rolls on the green's contours. What it leaves is valued with the putting map on the green and the short game round it."
                       Classes="muted small" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding ApproachPinButtons}" ItemTemplate="{StaticResource PillTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="From" Classes="muted small" VerticalAlignment="Center"/>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding FromButtons}" ItemTemplate="{StaticResource PillTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowFromYards}">
                <TextBox Text="{Binding FromYards}" Width="80" MinHeight="30"/>
                <TextBlock Text="yds to the pin," VerticalAlignment="Center"/>
                <TextBox Text="{Binding FromSide}" Width="70" MinHeight="30"/>
                <TextBlock Text="yds right (+) or left (−) of the line of play" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApproachFromText}" Classes="small" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Text="Aim" Classes="muted small" VerticalAlignment="Center"/>
              <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AimButtons}" ItemTemplate="{StaticResource PillTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAimDistance}">
                  <TextBox Text="{Binding AimDistanceText}" Width="80" MinHeight="30"/>
                  <TextBlock Text="yds, straight at the pin (the golfer still plans its release)" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAimPoint}">
                  <TextBox Text="{Binding AimRightText}" Width="70" MinHeight="30"/>
                  <TextBlock Text="yds right (+) / left (−) and" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding AimLongText}" Width="70" MinHeight="30"/>
                  <TextBlock Text="yds beyond (+) / short (−) of the pin" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Row="5" Text="Spreads" Classes="muted small" VerticalAlignment="Center"/>
              <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding SkillText}" Width="70" MinHeight="30"/>
                <TextBlock Text="× the fitted golfer (1 = the anchors' Tour player; 1.5 tries the hole for a weaker one)" VerticalAlignment="Center" Classes="small" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Play the approach" Command="{Binding RunApproachCommand}" IsEnabled="{Binding !ApproachBusy}" MinWidth="150"/>
              <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding ApproachBusy}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ApproachStatus}" TextWrapping="Wrap" IsVisible="{Binding ApproachStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasApproach}">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Image Source="{Binding ApproachMap}" Stretch="Uniform" MaxHeight="640" MaxWidth="520" AutomationProperties.Name="Where approach shots finish"/>
              <ItemsControl ItemsSource="{Binding ApproachLegend}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LegendItemViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="10" Height="10" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" Classes="small"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="14">
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding ApproachTitle}" Classes="mono small" TextWrapping="Wrap"/>
                <Border Classes="chip" Background="#FBE6DC" HorizontalAlignment="Left" Padding="10,2">
                  <TextBlock Text="{Binding ApproachBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="#B4471F" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding ApproachHeadline}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ApproachShape}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ApproachSg}" TextWrapping="Wrap"/>
                <StackPanel Spacing="4" IsVisible="{Binding HasAimRows}">
                  <TextBlock Text="Best aims (25 tried on a 3-yd grid round the pin, the same shots for each)" Classes="muted small" Margin="0,6,0,0"/>
                  <Grid ColumnDefinitions="200,90,80,90">
                    <TextBlock Text="Aim, yds from the pin" Classes="muted small"/>
                    <TextBlock Grid.Column="1" Text="Expected" Classes="muted small" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="Green" Classes="muted small" HorizontalAlignment="Right"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ApproachAimRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AimOptionRowViewModel">
                        <Grid ColumnDefinitions="200,90,80,90">
                          <TextBlock Text="{Binding Aim}" FontWeight="{Binding Weight}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Expected}" Classes="mono" HorizontalAlignment="Right" FontWeight="{Binding Weight}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Green}" Classes="mono" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding Note}" Classes="muted small" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding ApproachDepends}" Foreground="#B4471F" Classes="small" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="The simulated golfer" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GolferTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GolferDetail}" Classes="muted small" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="90,60,70,70,70">
                  <TextBlock Text="Lie" Classes="muted small"/>
                  <TextBlock Grid.Column="1" Text="Yds" Classes="muted small" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="Anchor" Classes="muted small" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Golfer" Classes="muted small" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="Off by" Classes="muted small" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding GolferRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalibrationRowViewModel">
                      <Grid ColumnDefinitions="90,60,70,70,70">
                        <TextBlock Text="{Binding Lie}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Yards}" Classes="mono" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Anchor}" Classes="mono" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Model}" Classes="mono" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Error}" Foreground="{Binding ErrorInk}" Classes="mono" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Played out on a plain calibration hole (flat, a 34-yd fairway, a round 26-yd green), shot after shot until holed, from each anchor's lie and distance. Off by more than 0.15 in red: the simple golfer can't match those rows without implausible values."
                           Classes="muted small" TextWrapping="Wrap"/>
                <Button Classes="primary" Content="Next: approach map" Command="{Binding GoApproachMapCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- 9 Approach map -->
      <StackPanel Spacing="14" IsVisible="{Binding IsApproachMap}">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding MapTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding MapPinButtons}" ItemTemplate="{StaticResource PillTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding MapBusy}">
              <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding MapStatus}" TextWrapping="Wrap" IsVisible="{Binding MapStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Border Classes="chip" Background="#FBE6DC" HorizontalAlignment="Left" Padding="10,2" IsVisible="{Binding HasPinMaps}">
              <TextBlock Text="{Binding MapBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="#B4471F" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>

        <!-- Par 4 and 5: the heat map -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding ShowHeat}">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Image Source="{Binding HeatImage}" Stretch="Uniform" MaxHeight="640" MaxWidth="520" AutomationProperties.Name="Approach heat map"/>
              <TextBlock Text="Green: better than the other spots the same distance away · red: worse · ringed: the best angle" Classes="muted small" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="Where to approach from" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding HeatBest}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding HeatSummary}" TextWrapping="Wrap"/>
              <TextBlock Text="Fairway spots the same distance from the pin: the best side against the worst (yds left or right of the tee line)" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Grid ColumnDefinitions="90,130,130,80">
                <TextBlock Text="Yds" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Best" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Worst" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Worth" Classes="muted small" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding BandRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BandRowViewModel">
                    <Grid ColumnDefinitions="90,130,130,80">
                      <TextBlock Text="{Binding Yards}" Classes="mono"/>
                      <TextBlock Grid.Column="1" Text="{Binding Best}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding Worst}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Premium}" Classes="mono" HorizontalAlignment="Right" FontWeight="{Binding Weight}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Par 3: tee shots from every tee -->
        <Border Classes="card" Padding="16" IsVisible="{Binding IsPar3Map}">
          <StackPanel Spacing="8">
            <TextBlock Text="Tee shots from every tee" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding TeeShotSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="70,60,70,110,80,70,80,70">
              <TextBlock Text="Tee" Classes="muted small"/>
              <TextBlock Grid.Column="1" Text="Yds" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="Plays" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="Best aim R / long" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="Expected" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="5" Text="Green" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="6" Text="At the pin" Classes="muted small" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="7" Text="SG" Classes="muted small" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding TeeShotRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeeShotRowViewModel">
                  <Grid ColumnDefinitions="70,60,70,110,80,70,80,70">
                    <TextBlock Text="{Binding Tee}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Yards}" Classes="mono" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding PlaysLike}" Classes="mono" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding Aim}" Classes="mono" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding Expected}" Classes="mono" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="{Binding Green}" Classes="mono" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="{Binding AtPin}" Classes="mono" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="{Binding Sg}" Classes="mono" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="49 aims per tee, 4 yds apart out to 12 yds from the pin, 300 shots each with the same draws. SG against the baseline's tee rows (the golfer was fitted on a flat green, so real greens read harder than Tour)." Classes="muted small" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Every hole: the leave map and the ideal angle -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasPinMaps}">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Image Source="{Binding LeaveImage}" Stretch="Uniform" MaxHeight="600" MaxWidth="520" AutomationProperties.Name="Where to leave the ball round the green"/>
              <TextBlock Text="{Binding LeaveLegend}" Classes="muted small" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="The ideal angle in" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding AngleSummary}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="80,80,70,70">
                <TextBlock Text="From" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Expected" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Green" Classes="muted small" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding AngleRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AngleRowViewModel">
                    <Grid ColumnDefinitions="80,80,70,70">
                      <TextBlock Text="{Binding Degrees}" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Expected}" Classes="mono" HorizontalAlignment="Right" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Green}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Note}" Classes="muted small" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Degrees right (R) or left (L) of the line of play, seen from the fairway looking at the green, all from 150 yds with each direction's best aim." Classes="muted small" TextWrapping="Wrap"/>
              <Button Classes="primary" Content="Next: second shot" Command="{Binding GoSecondShotCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- 10 Second shot -->
      <StackPanel Spacing="14" IsVisible="{Binding IsSecondShot}">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Second shot: go for it or lay up" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="From where the drive finishes, the player goes at the green with its longest fairway club, or lays up to any fairway spot in reach. Every option is played with the same shots and valued by the third shot it leaves: the approach heat map, misses included."
                       Classes="muted small" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SecondIntro}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding SecondPinButtons}" ItemTemplate="{StaticResource PillTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="From" Classes="muted small" VerticalAlignment="Center"/>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding SecondFromButtons}" ItemTemplate="{StaticResource PillTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSecondYards}">
                <TextBox Text="{Binding SecondYards}" Width="80" MinHeight="30"/>
                <TextBlock Text="yds to the pin," VerticalAlignment="Center"/>
                <TextBox Text="{Binding SecondSide}" Width="70" MinHeight="30"/>
                <TextBlock Text="yds right (+) or left (−) of the line of play" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SecondFromText}" Classes="small" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Text="Spreads" Classes="muted small" VerticalAlignment="Center"/>
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding SecondSkillText}" Width="70" MinHeight="30"/>
                <TextBlock Text="× the fitted golfer (try 1.5 to see when a weaker player should lay up)" VerticalAlignment="Center" Classes="small" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="primary" Content="Go or lay up?" Command="{Binding RunSecondShotCommand}" IsEnabled="{Binding !SecondBusy}" MinWidth="150"/>
              <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding SecondBusy}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding SecondStatus}" TextWrapping="Wrap" IsVisible="{Binding SecondStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasSecond}">
          <Border Classes="card" Padding="8" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Image Source="{Binding SecondMap}" Stretch="Uniform" MaxHeight="640" MaxWidth="520" AutomationProperties.Name="Lay-up targets against going for it"/>
              <TextBlock Text="Each lay-up target: green where laying up there beats going for it, red where going is better. Ringed: where the ball is, the go aim and the best lay-up." Classes="muted small" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding SecondTitle}" Classes="mono small" TextWrapping="Wrap"/>
              <Border Classes="chip" Background="#FBE6DC" HorizontalAlignment="Left" Padding="10,2">
                <TextBlock Text="{Binding SecondBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="#B4471F" TextWrapping="Wrap"/>
              </Border>
              <TextBlock Text="{Binding SecondVerdict}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding SecondVerdictBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SecondGo}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SecondLayup}" TextWrapping="Wrap"/>
              <TextBlock Text="The best lay-up for each distance left (yds from the pin, side of the tee line)" Classes="muted small" Margin="0,6,0,0"/>
              <Grid ColumnDefinitions="60,70,80,90,80">
                <TextBlock Text="Yds" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Side" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Expected" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Against go" Classes="muted small" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Fairway" Classes="muted small" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding LayupRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayupRowViewModel">
                    <Grid ColumnDefinitions="60,70,80,90,80">
                      <TextBlock Text="{Binding Yards}" Classes="mono" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding Expected}" Classes="mono" HorizontalAlignment="Right" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="3" Text="{Binding VsGo}" Foreground="{Binding VsGoInk}" Classes="mono" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding Fairway}" Classes="mono" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Against go: strokes a lay-up there saves (+) or costs (−) against going for the green." Classes="muted small" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SecondDepends}" Foreground="#B4471F" Classes="small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
