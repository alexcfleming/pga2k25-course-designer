<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pga2K25.Studio.ViewModels"
             xmlns:views="using:Pga2K25.Studio.Views"
             x:Class="Pga2K25.Studio.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ChecklistItemTemplate" x:DataType="vm:ChecklistItemViewModel">
      <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,8">
        <Grid ColumnDefinitions="128,*,Auto" ColumnSpacing="12">
          <Button MinHeight="30" Padding="8,0" CornerRadius="999" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Top" FontSize="12.5"
                  Content="{Binding Status}" Background="{Binding Fill}" Foreground="{Binding Ink}" BorderBrush="{Binding Edge}" Command="{Binding CycleCommand}"
                  ToolTip.Tip="Click to cycle Open, Done, Deliberate, N/A" AutomationProperties.Name="{Binding Text}"/>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
              <Border Classes="chip" BorderBrush="{StaticResource Control}" BorderThickness="1" Padding="8,1"><TextBlock Text="{Binding Source}" FontSize="11.5" Foreground="#3F4A43"/></Border>
              <Border Classes="chip" Background="#E3EDF5" Padding="8,1" IsVisible="{Binding HasEvidence}"><TextBlock Text="{Binding Evidence}" FontSize="11.5" Foreground="#1E4A70" TextWrapping="Wrap"/></Border>
            </WrapPanel>
            <TextBox Text="{Binding Note}" PlaceholderText="Note" MinHeight="30"/>
          </StackPanel>
          <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsCustom}" MinHeight="28" Padding="10,0" VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ToggleTemplate" x:DataType="vm:ToggleItemViewModel">
      <ToggleButton Classes="pill" Content="{Binding Label}" IsChecked="{Binding IsOn}" MinHeight="30" Padding="10,0"/>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <!-- Title bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chip" Background="{StaticResource Tint}" VerticalAlignment="Center">
            <TextBlock Text="Read only" FontSize="12" Foreground="#3F4A43"/>
          </Border>
          <Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}"/>
          <Button Classes="primary" Content="Build all products" Command="{Binding BuildAllCommand}" IsEnabled="{Binding !Busy}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Course Designer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Classes="nav" Content="Library" Command="{Binding BackToLibraryCommand}" Padding="6,2" MinHeight="0"/>
          <TextBlock Text="/" Classes="muted" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding CourseName}" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="20,6">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="160" IsIndeterminate="True" IsVisible="{Binding Busy}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Status}" Classes="muted small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Section menu -->
    <Border DockPanel.Dock="Left" Width="236" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0" Padding="12,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
          <TextBlock Text="Output folder" Classes="muted small" Margin="10,0"/>
          <TextBlock Text="{Binding OutputFolder}" Classes="mono" FontSize="11" Foreground="#3F4A43" TextWrapping="Wrap" Margin="10,0"/>
        </StackPanel>
        <StackPanel Spacing="18">
          <Button Classes="nav" Command="{Binding BackToLibraryCommand}">
            <TextBlock Text="← Library"/>
          </Button>
          <StackPanel Spacing="2">
            <DockPanel Margin="10,0,0,10">
              <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Background="#E6E9E3" Margin="0,0,10,0">
                <Image Source="{Binding CourseThumbnail}" Stretch="UniformToFill"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CourseName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CourseKindText}" Classes="muted small"/>
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,1" AutomationProperties.Name="{Binding Label}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="muted small" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}"/>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="Products" Classes="muted small" Margin="10,0,0,4"/>
            <ItemsControl ItemsSource="{Binding ProductSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,1" AutomationProperties.Name="{Binding Label}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="muted small" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}"/>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding !!Recent.Count}">
            <TextBlock Text="Recent" Classes="muted small" Margin="10,0"/>
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentCourseViewModel">
                  <Button Classes="nav" Command="{Binding OpenCommand}" Margin="0,1" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="28" Height="28" CornerRadius="5" ClipToBounds="True" Background="#E6E9E3">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,340" RowDefinitions="Auto,*" Margin="24,20,24,16" ColumnSpacing="16" RowSpacing="16">
      <!-- Header -->
      <DockPanel Grid.ColumnSpan="2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTerrain}" Margin="0,0,8,0">
            <Button Content="Open PDF" Command="{Binding OpenTerrainPdfCommand}" IsVisible="{Binding HasTerrainPdf}" ToolTip.Tip="Open the terrain map PDF"/>
            <Button Content="Open image" Command="{Binding OpenTerrainImageCommand}" IsVisible="{Binding HasTerrainImage}" ToolTip.Tip="Open the terrain map PNG"/>
            <Button Content="Build terrain map" Command="{Binding BuildTerrainCommand}" IsVisible="{Binding TerrainNotBuilt}" IsEnabled="{Binding !Busy}"/>
          </StackPanel>
          <Border Classes="chip" Background="{StaticResource AccentTint}" CornerRadius="8" IsVisible="{Binding HasModelCheck}">
            <TextBlock Text="{Binding ModelCheck}" FontSize="12" Foreground="{StaticResource AccentInk}"/>
          </Border>
          <Border Classes="chip" Background="#E3EDF5" CornerRadius="8">
            <TextBlock Text="{Binding SeaText}" FontSize="12" Foreground="#1E4A70"/>
          </Border>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Section}"/>
          <TextBlock Classes="muted">
            <Run Text="{Binding CourseName}"/>
            <Run Text=" · "/>
            <Run Text="{Binding CourseMeta}"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <!-- Viewer -->
      <Border Grid.Row="1" Classes="card" ClipToBounds="True" IsVisible="{Binding IsTerrain}">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <ListBox Classes="segmented" ItemsSource="{Binding Shadings}" SelectedItem="{Binding Shading}" VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <ToggleButton Classes="pill" Content="Surfaces" IsChecked="{Binding ShowSurfaces}" VerticalAlignment="Center"/>
              <ToggleButton Classes="pill" Content="Grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center"/>
              <ToggleButton Classes="pill" Content="Hilltops" IsChecked="{Binding ShowHilltops}" VerticalAlignment="Center"/>
              <Border Width="1" Height="22" Background="{StaticResource Hairline}" VerticalAlignment="Center" Margin="2,0"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Sketches" Classes="muted small" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SketchModes}" SelectedItem="{Binding SketchMode}" MinWidth="110" AutomationProperties.Name="Sketch layer"/>
              </StackPanel>
              <ToggleButton Classes="pill" Content="Notes" IsChecked="{Binding ShowNotes}" VerticalAlignment="Center"
                            ToolTip.Tip="Show the pinned notes"/>
              <ToggleButton Classes="pill" Content="+ Add note" IsChecked="{Binding PlacingNote}" VerticalAlignment="Center"
                            ToolTip.Tip="Then click the map where the note belongs"/>
              <ToggleButton Classes="pill" Content="Not water…" IsChecked="{Binding MarkingNotWater}" VerticalAlignment="Center" IsVisible="{Binding HasInlandWater}"
                            ToolTip.Tip="Then click a piece of modelled water that is dry in game: every product leaves it out"/>
              <ToggleButton Classes="pill" Content="Planting" IsChecked="{Binding ShowPlanting}" VerticalAlignment="Center"
                            ToolTip.Tip="The trees, bushes, grasses, flowers and walls placed in the designer"/>
              <ToggleButton Classes="pill" Content="Routing test" IsChecked="{Binding RoutingTestOn}" VerticalAlignment="Center"
                            ToolTip.Tip="Sketch a routing with par 3, 4 and 5 arrows and add up par and yards. Studio only: no product draws it."/>
              <Border Width="1" Height="22" Background="{StaticResource Hairline}" VerticalAlignment="Center" Margin="2,0"/>
              <Button Content="Hole view" Command="{Binding ShowHoleViewCommand}" IsEnabled="{Binding HasHole}" MinHeight="30" Padding="10,0"
                      VerticalAlignment="Center" ToolTip.Tip="Turn and zoom the map to the selected hole's sheet: tee at the bottom, green at the top"/>
              <Button Content="Whole map" Command="{Binding ShowWholeMapCommand}" MinHeight="30" Padding="10,0" VerticalAlignment="Center"
                      ToolTip.Tip="Back out to the whole map, north up"/>
            </WrapPanel>
          </Border>

          <!-- Planting layers: each redraws the map. -->
          <Border DockPanel.Dock="Top" BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Padding="12,8" IsVisible="{Binding ShowPlanting}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <TextBlock Text="Planting" Classes="muted small" VerticalAlignment="Center"/>
              <ToggleButton Classes="pill" IsChecked="{Binding PlantTrees}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="10" Height="10" Fill="#4F7F3A" VerticalAlignment="Center"/><TextBlock Text="Trees" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlantBushes}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="10" Height="10" Fill="#5B7A30" VerticalAlignment="Center"/><TextBlock Text="Bushes" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlantGrass}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="10" Height="10" Fill="#A88B45" VerticalAlignment="Center"/><TextBlock Text="Grass &amp; fescue" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlantFlowers}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="10" Height="10" Fill="#C0477A" VerticalAlignment="Center"/><TextBlock Text="Flowers" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlantWalls}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="10" Height="10" Fill="#4A4F4B" VerticalAlignment="Center"/><TextBlock Text="Walls &amp; fences" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <Border Width="1" Height="22" Background="{StaticResource Hairline}" VerticalAlignment="Center" Margin="2,0"/>
              <ToggleButton Classes="pill" Content="Trees by type" IsChecked="{Binding TreesByType}" VerticalAlignment="Center"
                            ToolTip.Tip="Conifers darker than broadleaf trees; off draws every tree in one green"/>
            </WrapPanel>
          </Border>

          <!-- Routing test tools: a par stays picked for repeated drops. -->
          <Border DockPanel.Dock="Top" BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Padding="12,8" IsVisible="{Binding RoutingTestOn}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <TextBlock Text="Routing test" Classes="muted small" VerticalAlignment="Center"/>
              <ToggleButton Classes="pill" IsChecked="{Binding PlacingPar3}" VerticalAlignment="Center" AutomationProperties.Name="Place par 3 arrows"
                            ToolTip.Tip="Press where the tee goes and drag toward the green">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M0,4 H11 V1 L18,5 L11,9 V6 H0 Z" Fill="#2B6CA3" VerticalAlignment="Center"/>
                  <TextBlock Text="Par 3 · 185" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlacingPar4}" VerticalAlignment="Center" AutomationProperties.Name="Place par 4 arrows"
                            ToolTip.Tip="Press where the tee goes and drag toward the green">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M0,9 H10 L17,2" Stroke="#C2641C" StrokeThickness="2.2" StrokeJoin="Round" VerticalAlignment="Center"/>
                  <TextBlock Text="Par 4 · 420" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="pill" IsChecked="{Binding PlacingPar5}" VerticalAlignment="Center" AutomationProperties.Name="Place par 5 arrows"
                            ToolTip.Tip="Press where the tee goes and drag toward the green">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M0,10 H7 L13,3 H19" Stroke="#6A3D8F" StrokeThickness="2.2" StrokeJoin="Round" VerticalAlignment="Center"/>
                  <TextBlock Text="Par 5 · 545" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <Border Width="1" Height="22" Background="{StaticResource Hairline}" VerticalAlignment="Center" Margin="2,0"/>
              <Button Content="↺ 15°" Command="{Binding TurnArrowLeftCommand}" IsEnabled="{Binding HasArrowSelected}" MinHeight="30" Padding="10,0"
                      VerticalAlignment="Center" AutomationProperties.Name="Turn the selected arrow 15 degrees anticlockwise"/>
              <Button Content="↻ 15°" Command="{Binding TurnArrowRightCommand}" IsEnabled="{Binding HasArrowSelected}" MinHeight="30" Padding="10,0"
                      VerticalAlignment="Center" AutomationProperties.Name="Turn the selected arrow 15 degrees clockwise"/>
              <Button Content="Straighten" Command="{Binding StraightenArrowCommand}" IsEnabled="{Binding HasBentArrowSelected}" MinHeight="30" Padding="10,0"
                      VerticalAlignment="Center" ToolTip.Tip="Take the bends out of the selected hole"/>
              <Button Content="Delete arrow" Command="{Binding DeleteArrowCommand}" IsEnabled="{Binding HasArrowSelected}" MinHeight="30" Padding="10,0"
                      VerticalAlignment="Center" Foreground="#8E2F1E"/>
              <Border Width="1" Height="22" Background="{StaticResource Hairline}" VerticalAlignment="Center" Margin="2,0"/>
              <ToggleButton Classes="pill" Content="Landing zones" IsChecked="{Binding ShowZones}" VerticalAlignment="Center"
                            ToolTip.Tip="Drive zones on par 4s and 5s, and layup zones on par 5s, labelled with their rise from the tee"/>
              <ToggleButton Classes="pill" Content="Corridors" IsChecked="{Binding ShowCorridors}" VerticalAlignment="Center"
                            ToolTip.Tip="A 70 yd band along each hole, with a warning where two holes crowd each other"/>
              <ToggleButton Classes="pill" Content="Walks" IsChecked="{Binding ShowWalks}" VerticalAlignment="Center"
                            ToolTip.Tip="Dashed lines from each green to the next tee, with their yards"/>
              <ToggleButton Classes="pill" Content="Ranges" IsChecked="{Binding ShowRanges}" VerticalAlignment="Center"
                            ToolTip.Tip="The usual length for each par, as a band near the arrow head"/>
            </WrapPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" BorderBrush="#E6E9E3" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="Holes" Classes="muted small" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ItemsControl ItemsSource="{Binding Holes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HoleButtonViewModel">
                    <Button Classes="hole" Classes.selected="{Binding IsSelected}" Content="{Binding Number}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Number, StringFormat=Hole {0}}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <Panel Background="#DDEBD9">
            <views:MapSurface x:Name="MapView" Cursor="Cross"/>
            <Border Background="{StaticResource Ink}" CornerRadius="8" Padding="10,6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
              <TextBlock Text="{Binding HoverText}" Foreground="White" Classes="mono small"/>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="10,6"
                    Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding HoleView}">
              <TextBlock Text="{Binding ViewText}" FontWeight="Medium" FontSize="13"/>
            </Border>
            <!-- North arrow: turns with the map; click for north up. -->
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="North. Click to turn the map north up." Cursor="Hand"
                    PointerPressed="NorthUp_Pressed">
              <Panel x:Name="NorthArrow" Width="42" Height="42">
                <Path Data="M 21,5 L 27,23 L 21,19 L 15,23 Z" Fill="#1F2622"/>
                <TextBlock Text="N" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </Panel>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Width="32" MinHeight="30" Padding="0" HorizontalContentAlignment="Center" Click="RotateLeft_Click"
                        ToolTip.Tip="Turn 15° anticlockwise (or right-drag / Shift + drag)" AutomationProperties.Name="Rotate anticlockwise">
                  <PathIcon Width="14" Height="14" Data="M7.11 8.53L5.7 7.11C4.8 8.27 4.24 9.61 4.07 11h2.02c.14-.87.49-1.72 1.02-2.47zM6.09 13H4.07c.17 1.39.72 2.73 1.62 3.89l1.41-1.42c-.52-.75-.87-1.59-1.01-2.47zm1.01 5.32c1.16.9 2.51 1.44 3.9 1.61V17.9c-.87-.15-1.71-.49-2.46-1.03L7.1 18.32zM13 4.07V1L8.45 5.55 13 10V6.09c2.84.48 5 2.94 5 5.91s-2.16 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93s-3.05-7.44-7-7.93z"/>
                </Button>
                <Button Width="32" MinHeight="30" Padding="0" HorizontalContentAlignment="Center" Click="RotateRight_Click"
                        ToolTip.Tip="Turn 15° clockwise (or right-drag / Shift + drag)" AutomationProperties.Name="Rotate clockwise">
                  <PathIcon Width="14" Height="14" Data="M7.11 8.53L5.7 7.11C4.8 8.27 4.24 9.61 4.07 11h2.02c.14-.87.49-1.72 1.02-2.47zM6.09 13H4.07c.17 1.39.72 2.73 1.62 3.89l1.41-1.42c-.52-.75-.87-1.59-1.01-2.47zm1.01 5.32c1.16.9 2.51 1.44 3.9 1.61V17.9c-.87-.15-1.71-.49-2.46-1.03L7.1 18.32zM13 4.07V1L8.45 5.55 13 10V6.09c2.84.48 5 2.94 5 5.91s-2.16 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93s-3.05-7.44-7-7.93z" RenderTransform="scale(-1,1)"/>
                </Button>
                <Border Width="1" Background="{StaticResource Hairline}" Margin="2,4"/>
                <Button Content="−" Width="32" MinHeight="30" Padding="0" HorizontalContentAlignment="Center" Click="ZoomOut_Click"
                        ToolTip.Tip="Zoom out (mouse wheel)" AutomationProperties.Name="Zoom out"/>
                <TextBlock x:Name="ZoomText" Classes="mono small" Width="46" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="+" Width="32" MinHeight="30" Padding="0" HorizontalContentAlignment="Center" Click="ZoomIn_Click"
                        ToolTip.Tip="Zoom in (mouse wheel)" AutomationProperties.Name="Zoom in"/>
                <Button Content="Fit" MinHeight="30" Padding="10,0" Command="{Binding ShowWholeMapCommand}" AutomationProperties.Name="Whole map"/>
              </StackPanel>
            </Border>
            <Border Background="#CCF3F4F0" IsVisible="{Binding Loading}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="220"/>
                <TextBlock Text="Rendering the terrain map…" Classes="muted" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Inspector -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsTerrain}">
        <StackPanel Spacing="16">
          <Border Classes="card" Padding="16" IsVisible="{Binding ShowPlanting}">
            <StackPanel Spacing="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="from the course file" Classes="muted" VerticalAlignment="Bottom"/>
                <TextBlock Text="Planting" FontSize="20" FontWeight="SemiBold"/>
              </DockPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !HasPlanting}"
                         Text="Nothing has been planted in the designer yet."/>
              <StackPanel Spacing="12" IsVisible="{Binding HasPlanting}">
                <UniformGrid Columns="2" ColumnSpacing="8">
                  <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                    <StackPanel>
                      <TextBlock Text="Trees" Classes="muted small"/>
                      <TextBlock Text="{Binding PlantingTrees}" FontSize="24" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding PlantingTreesSplit}" Classes="muted small" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                    <StackPanel>
                      <TextBlock Text="Species" Classes="muted small"/>
                      <TextBlock Text="{Binding PlantingSpeciesCount}" FontSize="24" FontWeight="SemiBold"/>
                      <TextBlock Text="of trees" Classes="muted small"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding PlantingRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlantingRowViewModel">
                      <DockPanel Margin="0,2">
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="mono small" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" Classes="small"/>
                          <TextBlock Text="{Binding How}" Classes="muted small"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="2">
                  <TextBlock Text="Tree species" Classes="muted small"/>
                  <ItemsControl ItemsSource="{Binding TreeSpeciesRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlantingRowViewModel">
                        <DockPanel Margin="0,1">
                          <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="mono small" VerticalAlignment="Center" Margin="8,0,0,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding How}" Classes="muted small" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Label}" Classes="small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="≈ counts come from scatter groups and planted areas, where the game picks the exact spots. Vegetation the game generates by itself isn't shown."/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="On printed sheets" Classes="muted small"/>
                <CheckBox Content="Terrain map (PNG and PDF)" IsChecked="{Binding PrintPlantingOnMap}"/>
                <CheckBox Content="Hole sheets" IsChecked="{Binding PrintPlantingOnSheets}"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Builds print the layers switched on above the map. Hole sheets leave flowers off."/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16" IsVisible="{Binding RoutingTestOn}">
            <StackPanel Spacing="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RoutingCount}" Classes="muted" VerticalAlignment="Bottom"/>
                <TextBlock Text="Routing test" FontSize="20" FontWeight="SemiBold"/>
              </DockPanel>
              <UniformGrid Columns="2" ColumnSpacing="8">
                <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                  <StackPanel><TextBlock Text="Total par" Classes="muted small"/><TextBlock Text="{Binding RoutingTotalPar}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                  <StackPanel><TextBlock Text="Approx. yards" Classes="muted small"/><TextBlock Text="{Binding RoutingTotalYards}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Text="{Binding RoutingMix}" FontSize="13"/>
              <TextBlock Text="{Binding RoutingNines}" Classes="muted small" TextWrapping="Wrap"
                         IsVisible="{Binding RoutingNines, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Text="{Binding RoutingWalks}" Classes="muted small" TextWrapping="Wrap"/>
              <StackPanel Spacing="2" IsVisible="{Binding HasRouting}">
                <Grid ColumnDefinitions="40,28,40,52,*,Auto">
                  <TextBlock Text="Hole" Classes="muted small"/>
                  <TextBlock Grid.Column="1" Text="Par" Classes="muted small"/>
                  <TextBlock Grid.Column="2" Text="Yds" Classes="muted small"/>
                  <TextBlock Grid.Column="3" Text="Rise" Classes="muted small"/>
                  <TextBlock Grid.Column="4" Text="Walk on" Classes="muted small"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding RoutingRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoutingRowViewModel">
                      <Border Background="{Binding Background}" CornerRadius="4">
                        <Grid ColumnDefinitions="40,28,40,52,*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Shape}" Classes="muted small" Margin="0,0,0,4"
                                     IsVisible="{Binding IsBent}"/>
                          <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0" Padding="2,0" MinHeight="28"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Number, StringFormat=Select hole {0}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding Par}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Yards}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding Rise}" Classes="mono small" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding Walk}" Classes="mono small" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                            <Button Content="▲" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" MinHeight="26" Width="26" Padding="0"
                                    HorizontalContentAlignment="Center" FontSize="10" AutomationProperties.Name="{Binding UpName}" ToolTip.Tip="Number this hole one earlier"/>
                            <Button Content="▼" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" MinHeight="26" Width="26" Padding="0"
                                    HorizontalContentAlignment="Center" FontSize="10" AutomationProperties.Name="{Binding DownName}" ToolTip.Tip="Number this hole one later"/>
                            <Button Content="×" Command="{Binding RemoveCommand}" MinHeight="26" Width="26" Padding="0" HorizontalContentAlignment="Center"
                                    Foreground="#8E2F1E" AutomationProperties.Name="{Binding RemoveName}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !HasRouting}"
                         Text="No arrows yet. Pick Par 3, Par 4 or Par 5 above the map, press where the tee goes and drag toward the green."/>

              <!-- The selected hole: its shape, zone and green rise, and its corridor. -->
              <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="12" IsVisible="{Binding HasArrowSelected}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SelectedHoleTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SelectedHoleShape}" Classes="small" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding SelectedHoleLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RoutingDetailViewModel">
                        <DockPanel Margin="0,1">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Classes="mono small" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Label}" Classes="small"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding SelectedHoleCorridors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RoutingCorridorViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                          <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Text}" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="Drag a dashed circle to swing the leg that ends there; the legs after it follow. Bends snap to 5°."/>
                </StackPanel>
              </Border>

              <!-- Corridors: every pair of holes that crowd each other, closest first. -->
              <StackPanel Spacing="4" IsVisible="{Binding HasRouting}">
                <TextBlock Text="Corridors" Classes="muted small"/>
                <ItemsControl ItemsSource="{Binding RoutingCorridorRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoutingCorridorViewModel">
                      <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0" Padding="0,2" MinHeight="26"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="Select the later hole">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Text}" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="270"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="small" Foreground="#2F6B3F" TextWrapping="Wrap" IsVisible="{Binding CorridorsClear}"
                           Text="All clear: every pair of holes is at least 100 yd apart, centre line to centre line."/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Placeholders" Classes="muted small"/>
                <ItemsControl ItemsSource="{Binding RoutingLegend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoutingLegendViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                        <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Text}" Classes="small" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding RoutingZonesText}"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="Drag an arrow to move it. On the selected arrow, the first dashed circle aims the whole hole and the others bend it. One routing test per course, saved as you go."/>
              </StackPanel>
              <Button Content="Clear routing test" Command="{Binding AskClearRoutingCommand}" IsEnabled="{Binding HasRouting}"
                      IsVisible="{Binding !ConfirmClearRouting}" HorizontalAlignment="Left" Foreground="#8E2F1E"/>
              <Border IsVisible="{Binding ConfirmClearRouting}" Background="#F6E0DA" CornerRadius="8" Padding="10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Content="Clear" Command="{Binding ClearRoutingCommand}" Foreground="#8E2F1E"/>
                    <Button Content="Cancel" Command="{Binding CancelClearRoutingCommand}"/>
                  </StackPanel>
                  <TextBlock Text="Delete every arrow? This can't be undone." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="4">
            <Expander HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Map options">
              <Expander.Header>
                <StackPanel Spacing="2">
                  <TextBlock Text="Map options" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding OptSummary}" Classes="muted small" TextWrapping="Wrap"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Area" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding OptArea}" HorizontalAlignment="Stretch" AutomationProperties.Name="Area"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Margin (m)" Classes="muted small"/>
                    <TextBox Text="{Binding OptMargin}" IsEnabled="{Binding OptMarginEnabled}" AutomationProperties.Name="Margin in metres"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Contour interval (ft)" Classes="muted small"/>
                    <TextBox Text="{Binding OptInterval}" PlaceholderText="Auto" AutomationProperties.Name="Contour interval in feet"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Index every" Classes="muted small"/>
                    <TextBox Text="{Binding OptIndex}" AutomationProperties.Name="Index contour every"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="Grid square (yd)" Classes="muted small"/>
                    <TextBox Text="{Binding OptGrid}" AutomationProperties.Name="Grid square in yards"/>
                  </StackPanel>
                </Grid>
                <CheckBox Content="Sea, ponds and streams" IsChecked="{Binding OptWater}"/>
                <CheckBox Content="Water-plane outlines (where lower ground floods)" IsChecked="{Binding OptWaterFootprints}"
                          IsEnabled="{Binding OptWater}" Margin="22,0,0,0"/>
                <CheckBox Content="Green-site circles on drawn greens" IsChecked="{Binding OptDrawnGreenSites}"
                          ToolTip.Tip="Off: only greens not yet drawn keep the circle and fall arrow"/>
                <StackPanel Spacing="4" IsVisible="{Binding !!NotWaterRows.Count}">
                  <TextBlock Text="Marked not water in game" Classes="muted small"/>
                  <ItemsControl ItemsSource="{Binding NotWaterRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NotWaterRowViewModel">
                        <DockPanel Margin="0,2">
                          <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" MinHeight="26" Padding="8,0"/>
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Printed resolution (px per metre)" Classes="muted small"/>
                  <TextBox Text="{Binding OptPrintPpm}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Printed resolution in pixels per metre"/>
                </StackPanel>
                <TextBlock Text="{Binding OptError}" Foreground="#A32D2D" TextWrapping="Wrap" IsVisible="{Binding OptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Apply" Command="{Binding ApplyOptionsCommand}"/>
                  <Button Content="Reset to defaults" Command="{Binding ResetOptionsCommand}"/>
                </StackPanel>
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="Saved for this course. The live map, the terrain map build and the hole sheets use them; hole sheets keep their own finer contours."/>
              </StackPanel>
            </Expander>
          </Border>
          <Border Classes="card" Padding="16" IsVisible="{Binding HasHole}">
            <StackPanel Spacing="14">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding HoleParYards}" Classes="muted" VerticalAlignment="Bottom"/>
                <TextBlock Text="{Binding HoleTitle}" FontSize="20" FontWeight="SemiBold"/>
              </DockPanel>
              <UniformGrid Columns="3" ColumnSpacing="8">
                <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                  <StackPanel><TextBlock Text="Tee" Classes="muted small"/><TextBlock Text="{Binding TeeFeet}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                  <StackPanel><TextBlock Text="Green" Classes="muted small"/><TextBlock Text="{Binding GreenFeet}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="{StaticResource Ground}" CornerRadius="8" Padding="10">
                  <StackPanel><TextBlock Text="Change" Classes="muted small"/><TextBlock Text="{Binding ChangeFeet}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                </Border>
              </UniformGrid>
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SiteText}" Classes="mono small" VerticalAlignment="Center"/>
                  <TextBlock Text="Green site as it lies" FontWeight="Medium"/>
                </DockPanel>
                <Border Height="8" Background="{StaticResource Tint}" CornerRadius="4" ClipToBounds="True">
                  <Border Width="{Binding TiltBarWidth}" Background="{Binding TiltBarBrush}" HorizontalAlignment="Left"/>
                </Border>
                <TextBlock Text="Before shaping; greens are levelled when built in game." Classes="muted small" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasWater}">
                <TextBlock Text="Water in play" FontWeight="Medium"/>
                <ItemsControl ItemsSource="{Binding WaterRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WaterRowViewModel">
                      <StackPanel Margin="0,2" Spacing="1">
                        <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Classes="mono small" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Yards along the line of play from the back tee; level above the map's 0 ft." Classes="muted small" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasLegs}">
                <TextBlock Text="Measured in game vs model" FontWeight="Medium"/>
                <Grid ColumnDefinitions="*,56,56,64">
                  <TextBlock Text="Leg" Classes="muted small"/>
                  <TextBlock Grid.Column="1" Text="Game" Classes="muted small" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="Model" Classes="muted small" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Off by" Classes="muted small" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Legs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegRowViewModel">
                      <Grid ColumnDefinitions="*,56,56,64" Margin="0,2">
                        <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Game}" Classes="mono" FontSize="13" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Model}" Classes="mono" FontSize="13" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Diff}" Classes="mono" FontSize="13" TextAlignment="Right" Foreground="{Binding DiffBrush}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Selected note -->
          <Border Classes="card" Padding="16" IsVisible="{Binding HasSelectedNote}">
            <StackPanel Spacing="10">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{Binding SelectedNote.KindBrush, FallbackValue=Gray}" Margin="0,0,10,0">
                  <TextBlock Text="{Binding SelectedNote.Number, FallbackValue=''}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Note" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox Classes="segmented" ItemsSource="{Binding NoteKinds}" SelectedItem="{Binding SelectedNote.Kind}" AutomationProperties.Name="Kind of note">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBox x:Name="NoteText" Text="{Binding SelectedNote.Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="260"
                       PlaceholderText="How to build it, what to plant, the idea…" AutomationProperties.Name="Note text"/>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Belongs to" Classes="muted small" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding NoteHoleChoices}" SelectedItem="{Binding SelectedNote.HoleChoice}" MinWidth="100"
                          AutomationProperties.Name="Hole the note belongs to"/>
              </DockPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Saved as you type. Drag the pin on the map to move it."/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Done" Command="{Binding DoneNoteCommand}"/>
                <Button Content="Delete note" Command="{Binding DeleteNoteCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Sketches -->
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Import scans…" Click="ImportScans_Click" IsEnabled="{Binding !Busy}" MinHeight="30" Padding="10,0"/>
                <TextBlock Classes="h2" Text="Hole sketches" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{Binding SketchSummary}" Classes="muted small" TextWrapping="Wrap"/>
              <StackPanel Spacing="10" IsVisible="{Binding HasSketches}">
                <ListBox Classes="segmented" ItemsSource="{Binding SketchModes}" SelectedItem="{Binding SketchMode}" AutomationProperties.Name="Sketch layer">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <CheckBox Content="Colour each hole" IsChecked="{Binding SketchColours}"/>
                <CheckBox Content="Shot lines and aim points" IsChecked="{Binding SketchConstruction}" IsVisible="{Binding HasTracedLines}"
                          ToolTip.Tip="The construction lines from the tee through the lettered aim points, the aim dots and hatching, dashed"/>
                <CheckBox Content="Raw pencil instead of traced lines" IsChecked="{Binding SketchRawPencil}" IsVisible="{Binding HasTracedLines}"/>
                <CheckBox Content="Whole scan for the selected hole" IsChecked="{Binding SketchScan}"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Opacity" Classes="muted small" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Slider Minimum="0.1" Maximum="1" Value="{Binding SketchOpacity}" AutomationProperties.Name="Sketch opacity"/>
                </DockPanel>
                <Expander HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                  <Expander.Header>
                    <TextBlock Text="Imported sheets" FontWeight="Medium"/>
                  </Expander.Header>
                  <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{Binding SketchRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SketchRowViewModel">
                          <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,6">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" MinHeight="26" Padding="8,0" VerticalAlignment="Center"/>
                              <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                              <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13"/>
                                <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open sketches folder" Command="{Binding OpenSketchFolderCommand}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding HasImportResults}">
                <TextBlock Text="Last import" FontWeight="Medium" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding ImportResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="small" TextWrapping="Wrap" Margin="0,1"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Scan the hole sheets printed from this app; a PDF of many pages is fine. Each page is matched to its hole, and the pencil is lifted off the print and laid on the ground where it was drawn."/>
            </StackPanel>
          </Border>

          <!-- Notes -->
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Classes="pill" Content="+ Add note" IsChecked="{Binding PlacingNote}"/>
                <TextBlock Classes="h2" Text="Notes" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{Binding NotesSummary}" Classes="muted small" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NoteViewModel">
                    <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,1" Padding="6,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{Binding KindBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Number}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                          <TextBlock FontSize="12" Classes="muted">
                            <Run Text="{Binding Kind}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding HoleText}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Summary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Open notes file" Command="{Binding OpenNotesFileCommand}" IsVisible="{Binding HasNotes}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Products" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding ProductRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProductRowViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,8">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Content="View" Command="{Binding ViewCommand}" IsEnabled="{Binding CanOpen}" MinHeight="30" Padding="10,0"/>
                          <Button Content="{Binding BuildLabel}" Command="{Binding BuildCommand}" MinHeight="30" Padding="10,0"/>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Product viewer -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card" ClipToBounds="True" IsVisible="{Binding IsProductView}">
        <DockPanel DataContext="{Binding ProductViewer}" x:DataType="vm:ProductViewerViewModel">
          <Border DockPanel.Dock="Top" BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="Open PDF" Command="{Binding OpenPdfCommand}" IsVisible="{Binding HasPdf}"/>
                <Button Content="Open image" Command="{Binding OpenImageCommand}" IsVisible="{Binding HasPages}"/>
                <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding HasPages}"/>
                <Button Content="Rebuild" Command="{Binding BuildCommand}" IsVisible="{Binding HasPages}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedPage.Title, FallbackValue=''}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" Classes="muted small" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" Foreground="#A32D2D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Top" BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Padding="14,6" IsVisible="{Binding HasStyles}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4">
              <TextBlock Text="Styles to build:" Classes="muted small" VerticalAlignment="Center"/>
              <ItemsControl ItemsSource="{Binding Styles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="14"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StyleChoiceViewModel">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>
          </Border>
          <ListBox DockPanel.Dock="Left" Width="214" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                   IsVisible="{Binding ManyPages}" Background="{StaticResource Ground}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageItemViewModel">
                <StackPanel Spacing="4" Margin="0,4">
                  <Border Background="White" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" MinHeight="60">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="230"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Panel Background="#E9EBE6">
            <views:ZoomImage Source="{Binding Image}" FitWidth="False" IsVisible="{Binding HasPages}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding NotBuilt}">
              <TextBlock HorizontalAlignment="Center" Classes="h2">
                <Run Text="{Binding Name}"/>
                <Run Text=" isn't built yet"/>
              </TextBlock>
              <TextBlock HorizontalAlignment="Center" Classes="muted" Text="Build it from the course file; it's saved to the course's output folder."/>
              <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding BuildCommand}">
                <TextBlock>
                  <Run Text="Build "/>
                  <Run Text="{Binding Name}"/>
                </TextBlock>
              </Button>
            </StackPanel>
            <Border Background="#CCF3F4F0" IsVisible="{Binding LoadingPage}" IsHitTestVisible="False">
              <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Measurements -->
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsMeasurements}">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Read from the course file"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Nothing to type: in the designer, draw a measure line on each hole from the tee marker to the aim-point marker and on to the green circle (one line with three clicks, or two lines), then save the course. The course file keeps every measure point with the game's own height, so each leg whose ends sit within 5 yds of the markers is read here when the course is opened again. These replace a typed reading for the same leg. Every other measure line in the file is listed too, with the game's height change along it against the model's, so a line laid anywhere checks the terrain. Leave the lines in place while you want them checked; delete them in the game to drop them."/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Add a reading"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Use the in-game measure tool from the back tee square to the aim-point marker, or from the aim point to the green circle. Yards are filled in from the course file, so you can check the click landed on the marker."/>
              <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Hole" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding HoleNumbers}" SelectedItem="{Binding NewHole}" Width="90"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Leg" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding LegChoices}" SelectedItem="{Binding NewLeg}" Width="150"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Yards" Classes="muted small"/>
                  <TextBox Text="{Binding NewYards}" Width="90"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Height change" Classes="muted small"/>
                  <TextBox Text="{Binding NewFeet}" Width="160" PlaceholderText="e.g. +13 ft 6 in"/>
                </StackPanel>
                <Button Classes="primary" Content="Add reading" Command="{Binding AddMeasurementCommand}" VerticalAlignment="Bottom"/>
              </WrapPanel>
              <TextBlock Text="{Binding MeasureError}" Foreground="#A32D2D" IsVisible="{Binding MeasureError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open file" Command="{Binding OpenMeasurementsFileCommand}"/>
                <StackPanel>
                  <TextBlock Classes="h2" Text="Readings"/>
                  <TextBlock Text="{Binding MeasurementSummary}" Classes="muted small"/>
                </StackPanel>
              </DockPanel>
              <Grid ColumnDefinitions="60,130,90,100,100,100,*" Margin="0,6,0,0">
                <TextBlock Text="Hole" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Leg" Classes="muted small"/>
                <TextBlock Grid.Column="2" Text="Yards" Classes="muted small" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Game" Classes="muted small" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Model" Classes="muted small" TextAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Off by" Classes="muted small" TextAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="From" Classes="muted small" Margin="16,0,0,0"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding MeasurementRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MeasurementRowViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,4">
                      <Grid ColumnDefinitions="60,130,90,100,100,100,*">
                        <TextBlock Text="{Binding Hole}" FontWeight="Medium" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Leg}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Yards}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Game}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Model}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{Binding Diff}" Classes="mono" TextAlignment="Right" Foreground="{Binding DiffBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="{Binding Source}" Classes="muted small" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="6" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" HorizontalAlignment="Right" MinHeight="28" Padding="10,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Saved to "/>
                <Run Text="{Binding MeasurementsFile}"/>
                <Run Text=". The course file is never changed."/>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Course settings -->
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsCourseSettings}">
        <Border Classes="card" Padding="20" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel Spacing="18">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Place"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Optional. Where the course is, real or invented. The place lines print under the name on the Plan Sheet scorecard map and before the terrain map's subtitle; the description and sea side fill the course cards wherever a card settings file leaves them unset. With a wind rose, the course data card's wind arrow follows the rose, as the Wind Card does; without one, it follows Prevailing wind from."/>
              <Grid ColumnDefinitions="*,10,*,10,*" Margin="0,4,0,0">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="Place line 1" Classes="muted small"/>
                  <TextBox Text="{Binding PlaceLine1}" PlaceholderText="e.g. Olkhon Island" AutomationProperties.Name="Place line 1"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="Place line 2" Classes="muted small"/>
                  <TextBox Text="{Binding PlaceLine2}" PlaceholderText="e.g. Lake Baikal" AutomationProperties.Name="Place line 2"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="3">
                  <TextBlock Text="Place line 3" Classes="muted small"/>
                  <TextBox Text="{Binding PlaceLine3}" PlaceholderText="Optional" AutomationProperties.Name="Place line 3"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="3">
                <TextBlock Text="One-line description (course cards)" Classes="muted small"/>
                <TextBox Text="{Binding PlaceDescription}" PlaceholderText="e.g. Cliff-top links on the shore of a great lake (fictional)" AutomationProperties.Name="Place description"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,10,*">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="Sea side" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding SeaSideChoices}" SelectedItem="{Binding SeaSideChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Sea side"/>
                  <TextBlock Text="{Binding DetectedSea}" Classes="muted small"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="Prevailing wind from" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding WindChoices}" SelectedItem="{Binding WindChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Prevailing wind"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="3">
                <TextBlock Text="Locator" Classes="muted small"/>
                <ComboBox ItemsSource="{Binding LocatorChoices}" SelectedItem="{Binding LocatorChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Locator"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="A small north-up map at the top of the terrain map's panel. The site: the whole plot, its sea (on plots with surf props) and the course's footprint in red. Generated region: an invented landscape round the course, its shore facing the plot's sea side, with the site in the corner."/>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsRegionLocator}">
                <Grid ColumnDefinitions="*,10,110,10,Auto,10,*">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Shape" Classes="muted small"/>
                    <ComboBox ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding ShapeChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Region shape"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Seed" Classes="muted small"/>
                    <TextBox Text="{Binding SeedText}" AutomationProperties.Name="Region seed"/>
                  </StackPanel>
                  <Button Grid.Column="4" Content="Reroll" Command="{Binding RerollRegionCommand}" VerticalAlignment="Bottom"/>
                  <StackPanel Grid.Column="6" Spacing="3">
                    <TextBlock Text="Size" Classes="muted small"/>
                    <ComboBox ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SizeChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Region size"/>
                  </StackPanel>
                </Grid>
                <CheckBox IsChecked="{Binding PlaceWatermark}" Content="Watermark the region behind the Plan Sheet scorecard map"/>
                <Border BorderBrush="#d6cfc2" BorderThickness="1" HorizontalAlignment="Left">
                  <Image Source="{Binding RegionPreview}" Width="480" Height="300" Stretch="Uniform" AutomationProperties.Name="Region preview"/>
                </Border>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="The same seed always draws the same coast. Place line 1 names the land."/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="Wind rose" Classes="muted small"/>
                <ComboBox ItemsSource="{Binding WindSourceChoices}" SelectedItem="{Binding WindSourceChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Wind rose source"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="How often the wind blows from each direction, by speed. Adds a Wind Card to the course cards and a wind block to the terrain map. A design aid: the game sets the wind each round."/>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsModelWind}">
                <StackPanel Spacing="3">
                  <TextBlock Text="Climate" Classes="muted small"/>
                  <ComboBox ItemsSource="{Binding ClimateChoices}" SelectedItem="{Binding ClimateChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Climate"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,10,*,10,110,10,Auto">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Strength" Classes="muted small"/>
                    <ComboBox ItemsSource="{Binding StrengthChoices}" SelectedItem="{Binding StrengthChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Wind strength"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Steadiness" Classes="muted small"/>
                    <Slider Minimum="0.4" Maximum="2.2" Value="{Binding WindSteadiness}" AutomationProperties.Name="Wind steadiness"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="3">
                    <TextBlock Text="Seed" Classes="muted small"/>
                    <TextBox Text="{Binding WindSeedText}" AutomationProperties.Name="Wind seed"/>
                  </StackPanel>
                  <Button Grid.Column="6" Content="Reroll" Command="{Binding RerollWindCommand}" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="The main wind blows from Prevailing wind from (west if not set). The sea-breeze lobe blows onshore from the sea side. The seed adds the small unevenness real records have."/>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsDataWind}">
                <Grid ColumnDefinitions="*,10,*,10,Auto">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Latitude (north +)" Classes="muted small"/>
                    <TextBox Text="{Binding LatitudeText}" PlaceholderText="e.g. 53.31" AutomationProperties.Name="Latitude"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Longitude (east +)" Classes="muted small"/>
                    <TextBox Text="{Binding LongitudeText}" PlaceholderText="e.g. 107.74" AutomationProperties.Name="Longitude"/>
                  </StackPanel>
                  <Button Grid.Column="4" Content="Fetch wind data" Command="{Binding FetchWindCommand}" VerticalAlignment="Bottom" IsVisible="{Binding AllowOnlineWind}"/>
                </Grid>
                <TextBlock Text="{Binding WindStatus}" Classes="muted small" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasWind}">
                <Border BorderBrush="#d6cfc2" BorderThickness="1" HorizontalAlignment="Left">
                  <Image Source="{Binding WindPreview}" Width="315" Height="330" Stretch="Uniform" AutomationProperties.Name="Wind rose preview"/>
                </Border>
                <TextBlock Text="{Binding WindSummary}" Classes="muted small" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Saved as you type to Place.json in "/>
                <Run Text="{Binding OutputFolder}"/>
                <Run Text=". The course file is never changed."/>
              </TextBlock>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Holes"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Optional. What the course file can't say about its holes. Tee names head the yardage columns of the yardage book, scorecard maps and course cards; hole names add a Name column to every scorecard table (left out when no hole is named). Hazards and green notes fill the hole data card: leave them blank to use what is read from the course file, shown faint. Pars, yardages and bearings always come from the course file."/>
              <StackPanel Spacing="3" Margin="0,4,0,0">
                <TextBlock Text="Tee set names, shortest first" Classes="muted small"/>
                <TextBox Text="{Binding TeeNamesText}" PlaceholderText="e.g. Red, Green, White, Blue" AutomationProperties.Name="Tee set names"/>
                <TextBlock Text="{Binding TeeSetsHint}" Classes="muted small"/>
              </StackPanel>
              <Grid ColumnDefinitions="44,200,*,*" Margin="0,6,0,0">
                <TextBlock Text="Hole" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Name" Classes="muted small"/>
                <TextBlock Grid.Column="2" Text="Hazards (separate with ·)" Classes="muted small" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="3" Text="Green contours and hole positions" Classes="muted small" Margin="8,0,0,0"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding HoleEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HoleEntryViewModel">
                    <Grid ColumnDefinitions="44,200,*,*" Margin="0,2">
                      <TextBlock Text="{Binding Hole}" FontWeight="Medium" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Name" AutomationProperties.Name="Hole name"/>
                      <TextBox Grid.Column="2" Text="{Binding Hazards}" PlaceholderText="{Binding HazardsPlaceholder}" Margin="8,0,0,0" AutomationProperties.Name="Hazards"/>
                      <TextBox Grid.Column="3" Text="{Binding GreenNotes}" PlaceholderText="{Binding GreenNotesPlaceholder}" Margin="8,0,0,0" AutomationProperties.Name="Green notes"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Saved as you type to Holes.json in "/>
                <Run Text="{Binding OutputFolder}"/>
                <Run Text=". The course file is never changed."/>
              </TextBlock>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Logo"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Optional. The course's logo, in as many versions as you have: a seal (round, with the name), a mark (no text) and a lockup (mark beside the name), each in colour, ink (one dark colour) and light (for dark backgrounds). Each product prints the version that suits its paper: colour on the Modern maps, cards, greens and yardage books and the terrain map; ink on the engraved maps and the hole sketch sheets. A missing version falls back to the nearest one you gave. PNG with a transparent background works best."/>
              <Grid ColumnDefinitions="64,*" Margin="0,4,0,0">
                <StackPanel Grid.Column="0" Margin="0,22,0,0">
                  <TextBlock Text="Seal" Classes="muted small" Height="118" VerticalAlignment="Top" Padding="0,34,0,0"/>
                  <TextBlock Text="Mark" Classes="muted small" Height="118" VerticalAlignment="Top" Padding="0,34,0,0"/>
                  <TextBlock Text="Lockup" Classes="muted small" Height="118" VerticalAlignment="Top" Padding="0,34,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <UniformGrid Columns="3" Height="22">
                    <TextBlock Text="Colour" Classes="muted small"/>
                    <TextBlock Text="Ink (one dark colour)" Classes="muted small"/>
                    <TextBlock Text="Light (on dark)" Classes="muted small"/>
                  </UniformGrid>
                  <ItemsControl ItemsSource="{Binding LogoSlots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LogoSlotViewModel">
                        <StackPanel Spacing="2" Margin="0,0,10,6" Height="112">
                          <Button Click="ChooseLogo_Click" Tag="{Binding}" Height="84" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Background="{Binding Swatch}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                            <Panel>
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="72" IsVisible="{Binding HasImage}"/>
                              <TextBlock Text="+ Add…" Foreground="{Binding PromptBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasImage}"/>
                            </Panel>
                          </Button>
                          <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding HasImage}" Padding="6,1" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted small" Foreground="#8E2F1E" Text="{Binding LogoError}" IsVisible="{Binding LogoError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Copied into the Logos folder in "/>
                <Run Text="{Binding OutputFolder}"/>
                <Run Text=" and listed in Logos.json, so the course keeps them."/>
              </TextBlock>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Scorecard maps"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Bunker merge: painted bunker dabs closer than this are drawn as one bunker. 10 m suits sand painted as scattered dabs; 4 m keeps pots in a complex apart. Rebuild the scorecard maps to see it."/>
              <ComboBox ItemsSource="{Binding BunkerMerges}" SelectedItem="{Binding BunkerMerge}" MinWidth="160" Margin="0,6,0,0" AutomationProperties.Name="Bunker merge"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Course card settings"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Optional. A card settings file (wind, ocean side, formats) for the course cards."/>
              <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                  <Button Content="Choose…" Click="BrowseCardConfig_Click"/>
                  <Button Content="Clear" Command="{Binding ClearCardConfigCommand}"/>
                </StackPanel>
                <TextBox Text="{Binding CardConfigPath}" IsReadOnly="True" PlaceholderText="None"/>
              </DockPanel>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Files"/>
              <TextBlock Text="Course file (read only)" Classes="muted small"/>
              <TextBlock Text="{Binding CoursePath}" Classes="mono small" TextWrapping="Wrap"/>
              <TextBlock Text="Products and measurements" Classes="muted small" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding OutputFolder}" Classes="mono small" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Estimate inputs -->
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsEstimateInputs}">
        <StackPanel Spacing="16" MaxWidth="1320" HorizontalAlignment="Left" DataContext="{Binding EstimateInputs}" x:DataType="vm:EstimateInputsViewModel"
                    IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- Save bar -->
          <Border Classes="card" Padding="16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Save" Command="{Binding SaveInputsCommand}" IsEnabled="{Binding !Busy}"/>
                <Button Classes="primary" Content="Save and rebuild estimate" Command="{Binding SaveAndRebuildCommand}" IsEnabled="{Binding !Busy}"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="Estimate inputs"/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Leave a box blank to use the default. Course choices are saved for this course; prices are saved for every course."/>
                <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Land -->
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Land"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Ground inside the play splines is built; everything else is natural. Each hole's zone class sets how much of the finished relief counts as given. Fidelity shifts every class: more fidelity, more ground treated as natural, less earthwork."/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Fidelity offset" VerticalAlignment="Center" Width="110"/>
                <Slider Minimum="-0.5" Maximum="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FidelityOffset}" Width="320"/>
                <TextBlock Text="{Binding FidelityText}" Classes="mono" VerticalAlignment="Center" Width="50"/>
                <Button Content="Reset" Command="{Binding ResetFidelityCommand}" MinHeight="28" Padding="10,0"/>
              </StackPanel>
              <TextBlock Text="{Binding DefaultClassText}" Classes="muted small"/>
              <ItemsControl ItemsSource="{Binding Holes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HoleZoneRowViewModel">
                    <StackPanel Spacing="2" Width="190">
                      <TextBlock Text="{Binding Title}" Classes="muted small"/>
                      <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:EstimateInputsViewModel)DataContext).ZoneChoices}"
                                SelectedItem="{Binding ZoneClass}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Drawn zones in Estimate.json: "/>
                <Run Text="{Binding DrawnZones}"/>
                <Run Text=" (kept as they are)."/>
              </TextBlock>
              <Expander Header="Zone classes" Padding="8">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="170,70,80,60,70,70,*">
                    <TextBlock Text="Class" Classes="muted small"/>
                    <TextBlock Grid.Column="1" Text="Fidelity" Classes="muted small"/>
                    <TextBlock Grid.Column="2" Text="Wavelength" Classes="muted small"/>
                    <TextBlock Grid.Column="3" Text="Rock" Classes="muted small"/>
                    <TextBlock Grid.Column="4" Text="Drainage" Classes="muted small"/>
                    <TextBlock Grid.Column="5" Text="Clearing" Classes="muted small"/>
                    <TextBlock Grid.Column="6" Text="Notes" Classes="muted small"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PresetRowViewModel">
                        <Grid ColumnDefinitions="170,70,80,60,70,70,*">
                          <TextBlock Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Fidelity}" Classes="mono"/>
                          <TextBlock Grid.Column="2" Text="{Binding Wavelength}" Classes="mono"/>
                          <TextBlock Grid.Column="3" Text="{Binding Rock}" Classes="mono"/>
                          <TextBlock Grid.Column="4" Text="{Binding Drainage}" Classes="mono"/>
                          <TextBlock Grid.Column="5" Text="{Binding Clearing}" Classes="mono"/>
                          <TextBlock Grid.Column="6" Text="{Binding Notes}" Classes="muted small" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted small" Text="All zone values are placeholders (zone-presets.json)."/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- Project and course-wide -->
          <Grid ColumnDefinitions="*,16,*">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="Project"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Fractions, not percents (0.10 = 10 %). For this course only."/>
                <Grid ColumnDefinitions="*,90,100" Margin="0,4,0,0">
                  <TextBlock Text="Value" Classes="muted small"/>
                  <TextBlock Grid.Column="1" Text="Default" Classes="muted small" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="This course" Classes="muted small" Margin="10,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Project}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ValueRowViewModel">
                      <Grid ColumnDefinitions="*,90,100" Margin="0,2">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DefaultText}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding Value}" PlaceholderText="default" Margin="10,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="Course-wide items"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="How many of each this course needs: 0 for none (no practice range, no pond), 2 for two."/>
                <Grid ColumnDefinitions="*,90,100" Margin="0,4,0,0">
                  <TextBlock Text="Item" Classes="muted small"/>
                  <TextBlock Grid.Column="1" Text="Default" Classes="muted small" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="This course" Classes="muted small" Margin="10,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding CourseWide}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ValueRowViewModel">
                      <Grid ColumnDefinitions="*,90,100" Margin="0,2">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding DefaultText}" Classes="mono" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding Value}" PlaceholderText="default" Margin="10,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Unit prices -->
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Classes="h2" Text="Unit prices (all courses)"/>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Replace placeholders with quotes or a costing guide, and record where each came from. Your values are kept separately from the app's, so updates don't overwrite them; Reset goes back to the shipped price."/>
              <Grid ColumnDefinitions="210,60,130,80,80,80,64,130,*,64" Margin="0,6,0,0">
                <TextBlock Text="Item" Classes="muted small"/>
                <TextBlock Grid.Column="1" Text="Unit" Classes="muted small"/>
                <TextBlock Grid.Column="2" Text="Shipped" Classes="muted small"/>
                <TextBlock Grid.Column="3" Text="Likely" Classes="muted small"/>
                <TextBlock Grid.Column="4" Text="Low" Classes="muted small"/>
                <TextBlock Grid.Column="5" Text="High" Classes="muted small"/>
                <TextBlock Grid.Column="6" Text="Year" Classes="muted small"/>
                <TextBlock Grid.Column="7" Text="Status" Classes="muted small"/>
                <TextBlock Grid.Column="8" Text="Source" Classes="muted small"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Prices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PriceRowViewModel">
                    <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,4">
                      <Grid ColumnDefinitions="210,60,130,80,80,80,64,130,*,64">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding OriginText}" Classes="muted small"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Unit}" Classes="muted small" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ShippedText}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="3" Text="{Binding Price}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" Text="{Binding Low}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="5" Text="{Binding High}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="6" Text="{Binding Year}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="7" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding Status}" HorizontalAlignment="Stretch" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="8" Text="{Binding Source}" TextWrapping="Wrap" AcceptsReturn="False"/>
                        <Button Grid.Column="9" Content="Reset" Command="{Binding ResetCommand}" MinHeight="28" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="Files" Classes="h2"/>
              <TextBlock Text="This course's choices" Classes="muted small"/>
              <TextBlock Text="{Binding InputPath}" Classes="mono small" TextWrapping="Wrap"/>
              <TextBlock Text="Your prices (all courses)" Classes="muted small" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding PricesPath}" Classes="mono small" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Publish readiness -->
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsReadiness}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1720" HorizontalAlignment="Left" DataContext="{Binding Readiness}" x:DataType="vm:ReadinessViewModel"
                    IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- Gate -->
          <Border Classes="card" Padding="16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Import checklist backup…" Click="ImportReadiness_Click"/>
                <Button Content="Re-read course file" Command="{Binding RerunCommand}" IsEnabled="{Binding !Busy}"/>
                <Button Classes="primary" Content="Export record" Command="{Binding ExportRecordCommand}" IsEnabled="{Binding HasReport}"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="12" Height="12" Fill="{Binding GateBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding GateTitle}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding GateDetail}" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="320" Height="8" CornerRadius="4" Background="{StaticResource Tint}" HorizontalAlignment="Left">
                    <Border Width="{Binding OverallWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Accent}"/>
                  </Border>
                  <TextBlock Text="{Binding OverallText}" Classes="mono small" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding SourceText}" Classes="muted small" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Busy}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" TextWrapping="Wrap" MaxWidth="900"
                             IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ChoosingImport}">
                  <ComboBox ItemsSource="{Binding ImportChoices}" SelectedItem="{Binding ImportChoice}" Width="280"/>
                  <Button Classes="primary" Content="Import this course" Command="{Binding ImportChosenCommand}"/>
                  <Button Content="Cancel" Command="{Binding CancelImportCommand}"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding TabButtons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <Button Classes="pill" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding SelectCommand}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Overview -->
          <Grid ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding IsOverview}">
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="4">
                <DockPanel Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip" Background="{StaticResource AccentTint}"><TextBlock Text="{Binding PassCount}" FontSize="12" Foreground="{StaticResource AccentInk}"/></Border>
                    <Border Classes="chip" Background="#F6E0DA"><TextBlock Text="{Binding OpenCount}" FontSize="12" Foreground="#8E2F1E"/></Border>
                  </StackPanel>
                  <TextBlock Classes="h2" Text="From the course file"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Findings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FindingViewModel">
                      <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="12">
                          <Border Background="{Binding Fill}" CornerRadius="6" Padding="0,3" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Level}" Foreground="{Binding Ink}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Rule}" Classes="muted small"/>
                            <TextBox Text="{Binding Reason}" PlaceholderText="Why it's deliberate (kept with the mark)" IsVisible="{Binding CanMark}" Margin="0,4,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                            <Button Content="{Binding ShowLabel}" Command="{Binding ShowHoleCommand}" IsVisible="{Binding HasHole}" MinHeight="30" Padding="10,0"/>
                            <Button Content="{Binding MarkLabel}" Command="{Binding MarkCommand}" IsVisible="{Binding CanMark}" MinHeight="30" Padding="10,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="PASSING" Classes="muted small"/>
                    <ItemsControl ItemsSource="{Binding Passes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="16">
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Progress by stage"/>
                  <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StageRowViewModel">
                        <StackPanel Spacing="3" Margin="0,0,0,10">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="mono small"/>
                            <TextBlock Text="{Binding Title}"/>
                          </DockPanel>
                          <Border Width="260" Height="6" CornerRadius="3" Background="{StaticResource Tint}" HorizontalAlignment="Left">
                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding BarBrush}"/>
                          </Border>
                          <TextBlock Text="{Binding Note}" Classes="muted small" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Principles §9, §11.4" Classes="muted small" VerticalAlignment="Bottom"/>
                    <TextBlock Classes="h2" Text="Limits"/>
                  </DockPanel>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Proposed values, not rules: change any for this course. Leave the test drive blank until it's measured."/>
                  <ItemsControl ItemsSource="{Binding Limits}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LimitRowViewModel">
                        <StackPanel Spacing="2" Margin="0,0,8,8">
                          <TextBlock Text="{Binding Label}" Classes="muted small" TextWrapping="Wrap"/>
                          <TextBox Text="{Binding Value}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Apply and re-check" Command="{Binding ApplyLimitsCommand}" IsEnabled="{Binding !Busy}"/>
                    <Button Content="Defaults" Command="{Binding ResetLimitsCommand}" IsEnabled="{Binding !Busy}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- Hole QA -->
          <Grid ColumnDefinitions="*,400" ColumnSpacing="16" IsVisible="{Binding IsHoles}">
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Spacing="6" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="pill" Classes.selected="{Binding !MinimumsOnly}" Content="All checks" Command="{Binding ShowAllChecksCommand}"/>
                      <Button Classes="pill" Classes.selected="{Binding MinimumsOnly}" Content="TGC minimums" Command="{Binding ShowMinimumsCommand}"/>
                      <Border Width="8"/>
                      <Button Classes="pill" Classes.selected="{Binding !OpenHolesOnly}" Content="All holes" Command="{Binding ShowAllHolesCommand}"/>
                      <Button Classes="pill" Classes.selected="{Binding OpenHolesOnly}" Content="Holes with open checks" Command="{Binding ShowOpenHolesCommand}"/>
                    </StackPanel>
                    <TextBlock Classes="mono small" Text="{Binding HoleQaTotals}" HorizontalAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="Hole QA"/>
                    <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding HoleQaLede}"/>
                  </StackPanel>
                </DockPanel>
                <WrapPanel ItemSpacing="14" LineSpacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" CornerRadius="4" Background="White" BorderBrush="#8C958E" BorderThickness="1"/><TextBlock Classes="small" Text="Open" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" CornerRadius="4" Background="#2D6A42"/><TextBlock Classes="small" Text="Done" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" CornerRadius="4" Background="#3D6E9A"/><TextBlock Classes="small" Text="Deliberate" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" CornerRadius="4" Background="#E6E8E3" BorderBrush="#8C958E" BorderThickness="1"/><TextBlock Classes="small" Text="N/A" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="White" Stroke="#2D6A42" StrokeThickness="1.2" StrokeDashArray="2,1.5"/><TextBlock Classes="small" Text="note to write" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="#7A4A00"/><TextBlock Classes="small" Text="TGC minimum" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border CornerRadius="4" Background="#FBEFD9" Padding="6,1"><TextBlock Classes="small" Foreground="#7A4A00" Text="Relief 0.5 ft"/></Border><TextBlock Classes="small" Text="outside a limit" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Panel><Rectangle RadiusX="4" RadiusY="4" Fill="White" Stroke="#B07A1E" StrokeThickness="1" StrokeDashArray="3,2"/><TextBlock Classes="small" Foreground="#7A4A00" Text="Width 115" Margin="6,1"/></Panel>
                    <TextBlock Classes="small" Text="provisional: a warning only" VerticalAlignment="Center"/>
                  </StackPanel>
                </WrapPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Grid.IsSharedSizeScope="True">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,6,6">
                      <TextBlock Width="30" Text="Hole" Classes="muted small" VerticalAlignment="Bottom"/>
                      <TextBlock Width="64" Text="Par · yds" Classes="muted small" VerticalAlignment="Bottom"/>
                      <TextBlock Width="206" Text="Course file" Classes="muted small" VerticalAlignment="Bottom"/>
                      <ItemsControl ItemsSource="{Binding HoleQaHeader}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="9"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HoleGroupHeaderViewModel">
                            <Grid VerticalAlignment="Bottom">
                              <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="{Binding SizeGroup}"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"/>
                              <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:HoleColumnViewModel">
                                    <StackPanel Width="14" Spacing="3" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                      <LayoutTransformControl Height="84">
                                        <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#3F4A43" VerticalAlignment="Center"/>
                                      </LayoutTransformControl>
                                      <Ellipse Width="6" Height="6" Fill="#7A4A00" IsVisible="{Binding Minimum}" HorizontalAlignment="Center"/>
                                      <Border Height="6" IsVisible="{Binding !Minimum}"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Width="44" Text="Done" Classes="muted small" TextAlignment="Right" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding HoleQaRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HoleQaRowViewModel">
                          <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="6,4" CornerRadius="6"
                                  Background="{Binding IsSelected, Converter={x:Static vm:HoleQaLook.RowFill}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <Button Width="30" Padding="0" Background="Transparent" BorderThickness="0" Content="{Binding Hole}" FontWeight="Bold" FontSize="14"
                                      Command="{Binding SelectCommand}" ToolTip.Tip="{Binding SelectTip}" AutomationProperties.Name="{Binding SelectTip}" VerticalAlignment="Center"/>
                              <TextBlock Width="64" Text="{Binding ParYards}" Classes="mono small" VerticalAlignment="Center"/>
                              <Panel Width="206" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Flags}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="3" LineSpacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FlagChipViewModel">
                                      <Panel>
                                        <Rectangle RadiusX="4" RadiusY="4" Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" StrokeDashArray="{Binding Dashes}"/>
                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Ink}" Margin="6,1"/>
                                      </Panel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="all within limits" FontSize="11" Classes="muted" IsVisible="{Binding Clean}"/>
                              </Panel>
                              <ItemsControl ItemsSource="{Binding Groups}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="9"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:QaCellGroupViewModel">
                                    <Grid>
                                      <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="{Binding SizeGroup}"/></Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QaCellViewModel">
                                          <Button Width="14" Height="14" MinHeight="0" MinWidth="0" Padding="0" Background="Transparent" BorderThickness="0"
                                                  Opacity="{Binding Asked, Converter={x:Static vm:HoleQaLook.Shown}}" IsHitTestVisible="{Binding Asked}"
                                                  Command="{Binding CycleCommand}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                                            <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1.2" StrokeDashArray="{Binding Dashes}"/>
                                          </Button>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Width="44" Text="{Binding Count}" Classes="mono small" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted small" Margin="0,8,0,0" TextWrapping="Wrap" Text="Relief, tee to green and pin slopes come from the terrain model: confirm in game. Provisional figures come from a small sample of reviewed courses and only ever warn."/>
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Top" IsVisible="{Binding Card, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="12" DataContext="{Binding Card}" x:DataType="vm:HoleCardViewModel">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Sub}" VerticalAlignment="Bottom"/>
                  <TextBlock Classes="h2" FontSize="20" Text="{Binding Title}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Measures}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="6" RowSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MeasureBoxViewModel">
                      <Panel>
                        <Rectangle RadiusX="6" RadiusY="6" Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" StrokeDashArray="{Binding Dashes}"/>
                        <StackPanel Margin="8,6" Spacing="1">
                          <TextBlock Text="{Binding Label}" FontSize="11" Classes="muted" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Value}" Classes="mono small"/>
                        </StackPanel>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="6" IsVisible="{Binding IsLong}">
                  <TextBlock Text="Landing zone" FontWeight="SemiBold"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding WidthLimits}"/>
                  <ItemsControl ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MeasureBoxViewModel">
                        <Panel>
                          <Rectangle RadiusX="6" RadiusY="6" Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" StrokeDashArray="{Binding Dashes}"/>
                          <StackPanel Margin="8,6" Spacing="1">
                            <TextBlock Text="{Binding Label}" FontSize="11" Classes="muted" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Value}" Classes="mono" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Pattern}"/>
                  <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding StartFromFile}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Your fairway start (yds)" VerticalAlignment="Center" Classes="small"/>
                    <TextBox Width="64" Text="{Binding OverrideText}" Watermark="from file">
                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyOverrideCommand}"/></TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Apply and re-check" Command="{Binding ApplyOverrideCommand}"/>
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding HazardsLabel}"/>
                  <ItemsControl ItemsSource="{Binding Hazards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String"><TextBlock Classes="mono small" Text="{Binding}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted small" Text="None near the line." IsVisible="{Binding NoHazards}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Shared fairway" IsChecked="{Binding Shared}"/>
                    <TextBlock Text="with holes" VerticalAlignment="Center" Classes="small"/>
                    <TextBox Width="90" Text="{Binding SharedWith}" Watermark="e.g. 6, 9"/>
                  </StackPanel>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="A shared fairway still counts in the width checks; it's left out of the fairway-start median."/>
                </StackPanel>

                <Panel IsVisible="{Binding IsLong}">
                  <Rectangle RadiusX="8" RadiusY="8" Stroke="#2D6A42" StrokeThickness="1" StrokeDashArray="3,2"/>
                  <StackPanel Margin="12,10" Spacing="8">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Hole design notes" FontWeight="SemiBold"/>
                      <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Required: an empty note keeps the hole open."/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Notes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteBoxViewModel">
                          <StackPanel Spacing="3" Margin="0,0,0,6">
                            <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Label}"/>
                            <TextBox Text="{Binding Text}" Watermark="{Binding Hint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Panel>

                <StackPanel Spacing="4" IsVisible="{Binding HasPins}">
                  <TextBlock Text="Pins" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="40,60,*,*">
                    <TextBlock Classes="muted" FontSize="11" Text="Pin"/>
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Text="Where"/>
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Text="From edge"/>
                    <TextBlock Grid.Column="3" Classes="muted" FontSize="11" Text="Slope at cup"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Pins}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PinLineViewModel">
                        <Grid ColumnDefinitions="40,60,*,*" Margin="0,1">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Number}"/>
                          <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding Where}"/>
                          <Border Grid.Column="2" Background="{Binding EdgeFill}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left"><TextBlock Classes="mono small" Text="{Binding Edge}"/></Border>
                          <Border Grid.Column="3" Background="{Binding SlopeFill}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left"><TextBlock Classes="mono small" Text="{Binding Slope}"/></Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardGroupViewModel">
                      <Border BorderBrush="{StaticResource Tint}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                        <StackPanel Spacing="2">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Mark the rest done" Command="{Binding FinishCommand}" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Accent}" FontSize="12" Padding="2,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"/>
                              <TextBlock Text="{Binding Count}" Classes="mono small muted" VerticalAlignment="Center"/>
                            </StackPanel>
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CardItemViewModel">
                                <DockPanel Margin="0,1" MinHeight="28">
                                  <Button DockPanel.Dock="Right" Width="88" MinHeight="26" Padding="4,0" CornerRadius="999" HorizontalContentAlignment="Center" FontSize="12"
                                          Content="{Binding Label}" Background="{Binding Fill}" Foreground="{Binding Ink}" BorderBrush="{Binding Edge}"
                                          Command="{Binding CycleCommand}" AutomationProperties.Name="{Binding Text}"/>
                                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}" Background="Transparent">
                                    <Ellipse Width="6" Height="6" Fill="#7A4A00" Opacity="{Binding Minimum, Converter={x:Static vm:HoleQaLook.Shown}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="260"/>
                                  </StackPanel>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="4">
                  <TextBlock Classes="muted small" Text="Note on this hole"/>
                  <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Checklists -->
          <Grid ColumnDefinitions="240,*" ColumnSpacing="16" IsVisible="{Binding IsChecklists}">
            <Border Classes="card" Padding="10" VerticalAlignment="Top">
              <ItemsControl ItemsSource="{Binding StageNav}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageNavViewModel">
                    <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,1">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="mono small" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="{Binding StageTitle}"/>
                <TextBlock Classes="muted small" Text="{Binding StageLede}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ChecklistItemTemplate}"/>
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Content="Add check" Command="{Binding AddItemCommand}" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding NewItemText}" PlaceholderText="Add your own check to this stage"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Pins and playtest -->
          <StackPanel Spacing="16" IsVisible="{Binding IsPins}">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Pins"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Where each pin sits comes from the file: front, centre or back along the approach, then left, centre or right. Click to set its difficulty: hard, medium, easy. Mix them up."/>
                <TextBlock Text="{Binding PinTally}" Classes="mono small" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding PinRows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="6"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PinRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Width="26" Text="{Binding Hole}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding Pins}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PinCellViewModel">
                              <Button Width="68" MinHeight="40" Padding="2" HorizontalContentAlignment="Center" Background="{Binding Fill}" Foreground="{Binding Ink}"
                                      Command="{Binding CycleCommand}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                                <StackPanel>
                                  <TextBlock Text="{Binding Position}" Classes="mono" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                  <TextBlock Text="{Binding Difficulty}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Playtest coverage"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Goal: every wind direction at high intensity at least once with each player profile, and every tee set and pin played. Directions are the in-game setting: N blows from the south towards the north."/>
                <ItemsControl ItemsSource="{Binding Profiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileViewModel">
                      <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="12" Width="440">
                        <StackPanel Spacing="8">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PrevailingText}" Classes="muted small" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          </DockPanel>
                          <UniformGrid Columns="3">
                            <StackPanel Spacing="2" Margin="0,0,6,0"><TextBlock Text="Style" Classes="muted small"/><TextBox Text="{Binding Style}"/></StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,6,0"><TextBlock Text="Wind intensity" Classes="muted small"/><TextBox Text="{Binding Wind}"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="Player profile" Classes="muted small"/><TextBox Text="{Binding Player}"/></StackPanel>
                          </UniformGrid>
                          <TextBlock Text="Winds played" Classes="muted small"/>
                          <ItemsControl ItemsSource="{Binding Winds}" ItemTemplate="{StaticResource ToggleTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          </ItemsControl>
                          <TextBlock Text="Tee sets played" Classes="muted small"/>
                          <ItemsControl ItemsSource="{Binding Tees}" ItemTemplate="{StaticResource ToggleTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          </ItemsControl>
                          <TextBlock Text="Pins played" Classes="muted small"/>
                          <ItemsControl ItemsSource="{Binding PinsPlayed}" ItemTemplate="{StaticResource ToggleTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Publish gate -->
          <Grid ColumnDefinitions="*,380" ColumnSpacing="16" IsVisible="{Binding IsGate}">
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="Publish gate"/>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Nothing goes out until every box here is done, the course-file checks are cleared or marked deliberate, and the sign-off is filled in."/>
                <ItemsControl ItemsSource="{Binding GateItems}" ItemTemplate="{StaticResource ChecklistItemTemplate}"/>
                <TextBlock Text="Still to do" Classes="muted small" Margin="0,10,0,0" IsVisible="{Binding !!Blockers.Count}"/>
                <ItemsControl ItemsSource="{Binding Blockers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Foreground="#8E2F1E" Margin="0,2"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="16">
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="8">
                  <TextBlock Classes="h2" Text="Sign-off"/>
                  <StackPanel Spacing="2"><TextBlock Text="Designer" Classes="muted small"/><TextBox Text="{Binding Designer}"/></StackPanel>
                  <StackPanel Spacing="2"><TextBlock Text="Version" Classes="muted small"/><TextBox Text="{Binding Version}"/></StackPanel>
                  <StackPanel Spacing="2"><TextBlock Text="Tee set names, front to back" Classes="muted small"/><TextBox Text="{Binding TeeNames}" PlaceholderText="Red, Green, White, Blue"/></StackPanel>
                  <StackPanel Spacing="2"><TextBlock Text="Signed off by" Classes="muted small"/><TextBox Text="{Binding SignName}"/></StackPanel>
                  <StackPanel Spacing="2"><TextBlock Text="Date" Classes="muted small"/><TextBox Text="{Binding SignDate}" PlaceholderText="Year-month-day"/></StackPanel>
                  <StackPanel Spacing="2"><TextBlock Text="Notes and known issues going out with this version" Classes="muted small"/>
                    <TextBox Text="{Binding SignNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/></StackPanel>
                  <Button Classes="primary" Content="Sign off this version" Command="{Binding SignOffCommand}" IsEnabled="{Binding HasReport}"/>
                  <TextBlock Text="{Binding SignedStampText}" Classes="muted small" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h2" Text="Lighting from the file"/>
                  <TextBlock Text="{Binding LightingText}" TextWrapping="Wrap"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Recorded each time the file is read, so the published course can be matched against it."/>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h2" Text="Files"/>
                  <TextBlock Text="Progress (saved as you go)" Classes="muted small"/>
                  <TextBlock Text="{Binding StatePath}" Classes="mono small" TextWrapping="Wrap"/>
                  <Button Content="Show in folder" Command="{Binding OpenStateFileCommand}" HorizontalAlignment="Left"/>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Export record writes a dated HTML page and JSON of everything here into the output folder, as the record of the course."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Hole design simulator -->
      <Panel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsHoleSim}">
        <views:HoleSimView DataContext="{Binding HoleSim}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
