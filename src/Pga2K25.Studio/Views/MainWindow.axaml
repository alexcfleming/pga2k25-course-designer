<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pga2K25.Studio.ViewModels"
        xmlns:views="using:Pga2K25.Studio.Views"
        x:Class="Pga2K25.Studio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Course Designer" Width="1440" Height="920" MinWidth="960" MinHeight="640"
        Background="{StaticResource Ground}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:WorkspaceViewModel">
      <views:WorkspaceView/>
    </DataTemplate>
  </Window.DataTemplates>
  <ContentControl Content="{Binding Current}"/>
</Window>
