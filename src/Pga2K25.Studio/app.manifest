<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares Windows 10 and 11 as supported. Without this Windows treats the program as written for an older
  system and won't let Avalonia create the child window that hosts a native control: the 3D view's web view
  then fails with "Unable to create child window for native control host".
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="CourseDesignerStudio"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
