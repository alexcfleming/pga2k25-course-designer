<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pga2K25.Studio.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="Ground" Color="#F3F4F0"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#18211C"/>
    <SolidColorBrush x:Key="Muted" Color="#56605A"/>
    <SolidColorBrush x:Key="Hairline" Color="#DDE1DA"/>
    <SolidColorBrush x:Key="Control" Color="#C9CFC6"/>
    <SolidColorBrush x:Key="Accent" Color="#2D6A42"/>
    <SolidColorBrush x:Key="AccentDark" Color="#245836"/>
    <SolidColorBrush x:Key="AccentTint" Color="#E4EFE6"/>
    <SolidColorBrush x:Key="AccentInk" Color="#1F4D30"/>
    <SolidColorBrush x:Key="Tint" Color="#EEF0EA"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style Selector="Button, ToggleButton">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Control}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDark}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.pill, ToggleButton.pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="#3F4A43"/>
    </Style>
    <Style Selector="Button.pill.selected">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pill.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDark}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentTint}"/>
      <Setter Property="BorderBrush" Value="#9CC3A6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
    </Style>

    <Style Selector="Button.hole">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.hole.selected">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.hole.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDark}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#3F4A43"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{StaticResource AccentTint}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.coursecard">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Button.coursecard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Application.Styles>
</Application>
