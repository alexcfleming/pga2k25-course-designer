<Window x:Class="Pga2K25.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PGA 2K25 Course Designer — Greens Book" Height="640" Width="900" MinHeight="480" MinWidth="720"
        Background="White" FontFamily="Georgia" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1f1d1a"/>
        <SolidColorBrush x:Key="Grey" Color="#6b665e"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Greens Book" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Builds a one-page greens book PNG (all greens, slope colour) from a Course Designer .course file, with optional per-green studies and PDF. Terrain is reconstructed from the file's brush stamps, calibrated against in-game spot elevations on four Cassimbo greens."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Course file" VerticalAlignment="Center"/>
            <TextBox x:Name="CourseBox" Grid.Column="1" Padding="4"/>
            <Button Grid.Column="2" Content="Browse…" Click="BrowseCourse_Click"/>
            <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,8,0,0"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="6,8,0,0" Click="BrowseOutput_Click"/>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,6,0,10" VerticalAlignment="Center">
            <CheckBox x:Name="ColourBox" Content="Slope colour" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="StudiesBox" Content="High-res study per green" IsChecked="False" Margin="0,0,18,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="PdfBox" Content="PDF" IsChecked="False" Margin="0,0,24,0" VerticalAlignment="Center"/>
            <TextBlock Text="Brush hardness" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="HardnessSlider" Minimum="0" Maximum="0.9" Value="0.85" Width="140"
                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Value, ElementName=HardnessSlider, StringFormat={}{0:0.00}}" Width="40" Margin="6,0,24,0" VerticalAlignment="Center"/>
            <TextBlock Text="Credit" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="CreditBox" Text="ALEX C. FLEMING" Width="170" Padding="3"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="GenerateButton" Content="Create Greens Book" Margin="0" FontWeight="Bold" Click="Generate_Click"/>
            <Button x:Name="OpenButton" Content="Open Sheet" IsEnabled="False" Click="Open_Click"/>
            <Button Content="Open Folder" Click="OpenFolder_Click"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Foreground="{StaticResource Ink}" BorderBrush="#d8d4cc"/>
    </Grid>
</Window>
