<Window x:Class="Pga2K25.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PGA 2K25 Course Designer" Height="820" Width="1000" MinHeight="560" MinWidth="760"
        Background="White" FontFamily="Georgia" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1f1d1a"/>
        <SolidColorBrush x:Key="Grey" Color="#6b665e"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Course Designer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Greens books, scorecard maps, yardage books, terrain maps and course cards from PGA TOUR 2K25 Course Designer .course files (read only)."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Course file" VerticalAlignment="Center"/>
            <TextBox x:Name="CourseBox" Grid.Column="1" Padding="4"/>
            <Button Grid.Column="2" Content="Browse…" Click="BrowseCourse_Click"/>
            <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,8,0,0"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="6,8,0,0" Click="BrowseOutput_Click"/>
            <TextBlock Grid.Row="2" Text="Hole data" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="DataBox" Grid.Row="2" Grid.Column="1" Padding="4" Margin="0,8,0,0"
                     ToolTip="Optional spreadsheet (.xlsx or .csv) with tee names, bearings and notes. Yardages always come from the course file."/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="6,8,0,0" Click="BrowseData_Click"/>
            <TextBlock Grid.Row="3" Text="Credit" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="CreditBox" Grid.Row="3" Grid.Column="1" Text="ALEX C. FLEMING" Padding="4" Margin="0,8,0,0"/>
        </Grid>

        <TabControl Grid.Row="2" Margin="0,0,0,10" Padding="12">
            <TabItem Header="Greens Book">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="One-page PNG of every green with slope colour, contours, arrows and pins. Terrain is reconstructed from the file's brush stamps, calibrated against in-game spot elevations."/>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ColourBox" Content="Slope colour" IsChecked="True"/>
                        <CheckBox x:Name="StudiesBox" Content="High-res study per green"/>
                        <CheckBox x:Name="PdfBox" Content="PDF"/>
                        <TextBlock Text="Brush hardness" VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <Slider x:Name="HardnessSlider" Minimum="0" Maximum="0.95" Value="0.85" Width="140"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Value, ElementName=HardnessSlider, StringFormat={}{0:0.00}}" Width="40" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Button x:Name="GreensButton" Content="Create Greens Book" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Greens_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Scorecard Map">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Overhead course map traced from fairways, tees, greens, bunkers and waste areas, with hole routes, numbers and the scorecard."/>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Themes" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="VintageBox" Content="Vintage (ink on parchment)" IsChecked="True"/>
                        <CheckBox x:Name="ModernBox" Content="Modern (flat colour)" IsChecked="True"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="OrientationBox" Width="110" SelectedIndex="0" Margin="0,0,18,0">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Landscape"/>
                            <ComboBoxItem Content="Portrait"/>
                        </ComboBox>
                        <CheckBox x:Name="RotateBox" Content="Rotate to fit (north arrow)" IsChecked="True"/>
                        <CheckBox x:Name="PathsBox" Content="Paths &amp; roads" IsChecked="True"/>
                        <CheckBox x:Name="WasteBox" Content="Waste areas"/>
                        <CheckBox x:Name="MergeBox" Content="Smooth bunkers" IsChecked="True"/>
                        <TextBlock Text="merge (m)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="MergeMetresBox" Text="10" Width="36" Padding="2" Margin="0,0,18,0"/>
                        <CheckBox x:Name="MapPdfBox" Content="PDF"/>
                        <TextBlock Text="Subtitle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SubtitleBox" Text="PGA TOUR 2K25" Width="160" Padding="3"/>
                    </WrapPanel>
                    <Button x:Name="MapButton" Content="Create Scorecard Map" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Map_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Yardage Book">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="One portrait 4.25 × 11 in page per hole: carries and fronts of hazards, fairway widths, distance arcs, spot heights, aim points, green depth and every tee set. Written as a single vector PDF workbook."/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Holes" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="YardageHolesBox" Text="All" Width="120" Padding="3" Margin="0,0,18,0"
                                 ToolTip="All, or a list such as 1-9 or 1, 4, 11-14"/>
                        <CheckBox x:Name="YardagePdfBox" Content="PDF workbook" IsChecked="True"/>
                        <CheckBox x:Name="YardagePngBox" Content="PNG per hole (1275 × 3300)"/>
                        <CheckBox x:Name="YardageVerboseBox" Content="Explain hazard labels in log"/>
                    </WrapPanel>
                    <Button x:Name="YardageButton" Content="Create Yardage Book" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Yardage_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Terrain Map">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="One large north-up PNG of the plot for planning: contours with labelled index lines, relief or slope shading, hilltop spot heights, a lettered 100-yard grid, and the routing as sticks and dots with yardage ticks and green-site fall. Hole sheets: one 8.5 × 11 in page per hole, oriented like the yardage book, with finer contours and a yardage grid to sketch on."/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TerrainExtentBox" Width="150" SelectedIndex="0" Margin="0,0,18,0">
                            <ComboBoxItem Content="Routing + margin"/>
                            <ComboBoxItem Content="Full plot"/>
                            <ComboBoxItem Content="Buildable ground"/>
                        </ComboBox>
                        <TextBlock Text="Shading" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TerrainShadingBox" Width="110" SelectedIndex="0" Margin="0,0,18,0">
                            <ComboBoxItem Content="Relief"/>
                            <ComboBoxItem Content="Slope"/>
                            <ComboBoxItem Content="None"/>
                        </ComboBox>
                        <TextBlock Text="Contour (ft)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TerrainIntervalBox" Text="Auto" Width="44" Padding="2" Margin="0,0,18,0"
                                 ToolTip="Auto, or a contour interval in feet such as 2 or 5"/>
                        <TextBlock Text="px / m" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TerrainPpmBox" Text="4" Width="36" Padding="2" Margin="0,0,18,0"
                                 ToolTip="Output resolution: pixels per metre of ground"/>
                        <CheckBox x:Name="TerrainFeaturesBox" Content="Drawn surfaces" IsChecked="True"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TerrainButton" Content="Create Terrain Map" Margin="0" FontWeight="Bold" Click="Terrain_Click"/>
                        <Button x:Name="HoleSheetsButton" Content="Create Hole Sheets" Margin="18,0,0,0" FontWeight="Bold" Click="HoleSheets_Click"/>
                        <TextBlock Text="Holes" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox x:Name="SheetHolesBox" Text="All" Width="120" Padding="3"
                                 ToolTip="All, or a list such as 1-9 or 2, 7, 16. Letter PNGs at 300 dpi plus one PDF."/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Course Cards">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Compass rose, hole data card and course data card. Pars, yardages and bearings come from the course file; the Hole data workbook (if set) only adds tee names, hazard tags and green notes, and its yardages and bearings are checked against the file. Errors stop the build unless Force is ticked."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Card settings" VerticalAlignment="Center"/>
                        <TextBox x:Name="CardConfigBox" Grid.Column="1" Padding="4"
                                 ToolTip="Optional JSON: title, description, palette, ocean label and side, wind, logo, tee names (see docs/course-cards.md)"/>
                        <Button Grid.Column="2" Content="Browse…" Click="BrowseCardConfig_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Wind from (°)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CardWindBox" Width="44" Padding="2" Margin="0,0,18,0"
                                 ToolTip="Prevailing wind bearing (blows FROM), e.g. 225 for SW. Blank uses the settings file, or draws no wind."/>
                        <TextBlock Text="Ocean" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CardOceanBox" Width="120" SelectedIndex="0" Margin="0,0,18,0">
                            <ComboBoxItem Content="From settings"/>
                            <ComboBoxItem Content="Detect"/>
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="NORTH"/>
                            <ComboBoxItem Content="NORTH-EAST"/>
                            <ComboBoxItem Content="EAST"/>
                            <ComboBoxItem Content="SOUTH-EAST"/>
                            <ComboBoxItem Content="SOUTH"/>
                            <ComboBoxItem Content="SOUTH-WEST"/>
                            <ComboBoxItem Content="WEST"/>
                            <ComboBoxItem Content="NORTH-WEST"/>
                        </ComboBox>
                        <CheckBox x:Name="CardPngBox" Content="PNG" IsChecked="True"/>
                        <CheckBox x:Name="CardPdfBox" Content="PDF" IsChecked="True"/>
                        <CheckBox x:Name="CardSvgBox" Content="SVG"/>
                        <CheckBox x:Name="CardForceBox" Content="Force (draft despite errors)"/>
                    </WrapPanel>
                    <Button x:Name="CardsButton" Content="Create Course Cards" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Cards_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="OpenButton" Content="Open Last Output" Margin="0" IsEnabled="False" Click="Open_Click"/>
                <Button Content="Open Folder" Click="OpenFolder_Click"/>
            </StackPanel>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Foreground="{StaticResource Ink}" BorderBrush="#d8d4cc"/>
        </Grid>
    </Grid>
</Window>
