<Window x:Class="Pga2K25.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PGA 2K25 Course Designer" Height="700" Width="940" MinHeight="520" MinWidth="760"
        Background="White" FontFamily="Georgia" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1f1d1a"/>
        <SolidColorBrush x:Key="Grey" Color="#6b665e"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Course Designer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Greens books, scorecard maps and (soon) yardage book pages from PGA TOUR 2K25 Course Designer .course files."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Course file" VerticalAlignment="Center"/>
            <TextBox x:Name="CourseBox" Grid.Column="1" Padding="4"/>
            <Button Grid.Column="2" Content="Browse…" Click="BrowseCourse_Click"/>
            <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,8,0,0"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="6,8,0,0" Click="BrowseOutput_Click"/>
            <TextBlock Grid.Row="2" Text="Credit" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox x:Name="CreditBox" Grid.Row="2" Grid.Column="1" Text="ALEX C. FLEMING" Padding="4" Margin="0,8,0,0"/>
        </Grid>

        <TabControl Grid.Row="2" Margin="0,0,0,10" Padding="12">
            <TabItem Header="Greens Book">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="One-page PNG of every green with slope colour, contours, arrows and pins. Terrain is reconstructed from the file's brush stamps, calibrated against in-game spot elevations."/>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ColourBox" Content="Slope colour" IsChecked="True"/>
                        <CheckBox x:Name="StudiesBox" Content="High-res study per green"/>
                        <CheckBox x:Name="PdfBox" Content="PDF"/>
                        <TextBlock Text="Brush hardness" VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <Slider x:Name="HardnessSlider" Minimum="0" Maximum="0.95" Value="0.85" Width="140"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Value, ElementName=HardnessSlider, StringFormat={}{0:0.00}}" Width="40" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Button x:Name="GreensButton" Content="Create Greens Book" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Greens_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Scorecard Map">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Grey}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Overhead course map traced from fairways, tees, greens, bunkers and waste areas, with hole routes, numbers and the scorecard."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hole data (optional)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="DataBox" Grid.Column="1" Padding="3" ToolTip="Spreadsheet with tee names and yardages (.xlsx or .csv)"/>
                        <Button Grid.Column="2" Content="Browse…" Click="BrowseData_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Themes" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="VintageBox" Content="Vintage (ink on parchment)" IsChecked="True"/>
                        <CheckBox x:Name="ModernBox" Content="Modern (flat colour)" IsChecked="True"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="OrientationBox" Width="110" SelectedIndex="0" Margin="0,0,18,0">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Landscape"/>
                            <ComboBoxItem Content="Portrait"/>
                        </ComboBox>
                        <CheckBox x:Name="RotateBox" Content="Rotate to fit (north arrow)" IsChecked="True"/>
                        <CheckBox x:Name="PathsBox" Content="Paths &amp; roads" IsChecked="True"/>
                        <CheckBox x:Name="WasteBox" Content="Waste areas"/>
                        <CheckBox x:Name="MergeBox" Content="Smooth bunkers" IsChecked="True"/>
                        <TextBlock Text="merge (m)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="MergeMetresBox" Text="10" Width="36" Padding="2" Margin="0,0,18,0"/>
                        <CheckBox x:Name="MapPdfBox" Content="PDF"/>
                        <TextBlock Text="Subtitle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SubtitleBox" Text="PGA TOUR 2K25" Width="160" Padding="3"/>
                    </WrapPanel>
                    <Button x:Name="MapButton" Content="Create Scorecard Map" HorizontalAlignment="Left" Margin="0" FontWeight="Bold" Click="Map_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Yardage Book" IsEnabled="False">
                <TextBlock Text="Per-hole yardage book pages — next." Foreground="{StaticResource Grey}"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="OpenButton" Content="Open Last Output" Margin="0" IsEnabled="False" Click="Open_Click"/>
                <Button Content="Open Folder" Click="OpenFolder_Click"/>
            </StackPanel>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Foreground="{StaticResource Ink}" BorderBrush="#d8d4cc"/>
        </Grid>
    </Grid>
</Window>
